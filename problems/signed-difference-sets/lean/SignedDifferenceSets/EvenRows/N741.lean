module

public import SignedDifferenceSets.EvenContraction

/-!
# N741: no SDS by C28 (the even contraction)

Its `EvenCert` (`EvenCert.Ok` by `decide +kernel`) and its search on `ZMod r × Grp ks`,
split into checks of at most 20000 nodes where larger; generated by
`solver/evenrows.py` from `x_even_contraction`'s kills.
-/

@[expose] public section

namespace SignedDifferenceSets.EvenRows

-- one kernel check at a time: each search batch holds up to ~2 GB
set_option Elab.async false

/-- N741 SDS(64,46,30,[2,32]): `L = ZMod 16 × Grp [1]`, `c = 2`, `Q = 34`,
`t = 30`, `K = 22`, `Σ Z = ±22` (40705 search nodes). -/
def n741Row : Row := ⟨741, [2, 32], 46, 30⟩

/-- N741's certificate. -/
def n741Cert : EvenCert :=
  ⟨16, 1, 44, 22, [1], [[0, 1], [0, 1]], [[0, 1], [0, 0]]⟩

theorem n741_ok : n741Cert.Ok n741Row := by decide +kernel

theorem n741_pos : ∀ d ∈ n741Cert.r :: n741Cert.ks, 0 < d := by decide

/-- `below` with N741's search arguments. -/
abbrev n741Check (p : List ℤ) : Bool :=
  below (@Indexed.size (Grp (n741Cert.r :: n741Cert.ks)) _ (Grp.indexed _ n741_pos))
    (@Indexed.addIdx (Grp (n741Cert.r :: n741Cert.ks)) _ (Grp.indexed _ n741_pos))
    (n741Cert.c n741Row)
    ((n741Row.k + n741Row.lam * (2 * (n741Cert.c n741Row : ℤ) - 1)) / 4)
    (n741Row.lam * n741Cert.c n741Row / 2) n741Cert.K (n741Cert.s / 2)

/-- Prefixes, batch 0. -/
def n741Batch0 : List (List ℤ) :=
  [[1, 0, -1],
    [1, 0, 0],
    [1, 0, 1],
    [1, 1, -1],
    [1, 1, 0],
    [1, 1, 1],
    [2, 0, -2],
    [2, 0, -1],
    [2, 0, 0],
    [2, 0, 1],
    [2, 0, 2],
    [2, 1, -2],
    [2, 1, -1],
    [2, 1, 0],
    [2, 1, 1]]

set_option maxRecDepth 100000 in
theorem n741_below0 : ∀ p ∈ n741Batch0, n741Check p = true := by
  decide +kernel

/-- Prefixes, batch 1. -/
def n741Batch1 : List (List ℤ) :=
  [[2, 1, 2],
    [2, 2, -2],
    [2, 2, -1],
    [2, 2, 0],
    [2, 2, 1]]

set_option maxRecDepth 100000 in
theorem n741_below1 : ∀ p ∈ n741Batch1, n741Check p = true := by
  decide +kernel

/-- Prefixes, batch 2. -/
def n741Batch2 : List (List ℤ) :=
  [[2, 2, 2]]

set_option maxRecDepth 100000 in
theorem n741_below2 : ∀ p ∈ n741Batch2, n741Check p = true := by
  decide +kernel

/-- The prefixes of 3 coordinates (40705 nodes in 3 batches of at most
20000). -/
def n741Prefixes : List (List ℤ) :=
  n741Batch0 ++ n741Batch1 ++ n741Batch2

theorem n741_search : n741Cert.search n741Row = true :=
  onGrp_of n741_pos (noVector_of_top (P := n741Prefixes) (d := 2) (by decide)
    (by decide +kernel) fun p hp => by
      simp only [n741Prefixes, List.mem_append, or_assoc] at hp
      rcases hp with h | h | h
      exacts [n741_below0 p h, n741_below1 p h, n741_below2 p h])

/-- N741 has no SDS (C28). -/
theorem n741_not_hasSDS (inst : Fintype (Grp [2, 32])) :
    ¬ @HasSDS (Grp [2, 32]) _ inst 46 30 :=
  EvenCert.not_hasSDS (w := n741Row) (e := n741Cert) n741_ok n741_search inst

end SignedDifferenceSets.EvenRows
