module

public import SignedDifferenceSets.EvenContraction

/-!
# N4672: no SDS by C28 (the even contraction)

Its `EvenCert` (`EvenCert.Ok` by `decide +kernel`) and its search on `ZMod r × Grp ks`,
split into checks of at most 20000 nodes where larger; generated by
`solver/evenrows.py` from `x_even_contraction`'s kills.
-/

@[expose] public section

namespace SignedDifferenceSets.EvenRows

-- one kernel check at a time: each search batch holds up to ~2 GB
set_option Elab.async false

/-- N4672 SDS(144,38,2,[2,72]): `L = ZMod 1 × Grp [9]`, `c = 8`, `Q = 17`,
`t = 8`, `K = 19`, `Σ Z = ±9` (16078 search nodes). -/
def n4672Row : Row := ⟨4672, [2, 72], 38, 2⟩

/-- N4672's certificate. -/
def n4672Cert : EvenCert :=
  ⟨1, 3, 18, 19, [9], [[1], [0, 1]], [[1], [0, 1]]⟩

theorem n4672_ok : n4672Cert.Ok n4672Row := by decide +kernel

set_option maxRecDepth 100000 in
theorem n4672_search : n4672Cert.search n4672Row = true := by decide +kernel

/-- N4672 has no SDS (C28). -/
theorem n4672_not_hasSDS (inst : Fintype (Grp [2, 72])) :
    ¬ @HasSDS (Grp [2, 72]) _ inst 38 2 :=
  EvenCert.not_hasSDS (w := n4672Row) (e := n4672Cert) n4672_ok n4672_search inst

end SignedDifferenceSets.EvenRows
