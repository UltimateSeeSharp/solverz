module

public import SignedDifferenceSets.EvenContraction

/-!
# N20961: no SDS by C28 (the even contraction)

Its `EvenCert` (`EvenCert.Ok` by `decide +kernel`) and its search on `ZMod r × Grp ks`,
split into checks of at most 20000 nodes where larger; generated by
`solver/evenrows.py` from `x_even_contraction`'s kills.
-/

@[expose] public section

namespace SignedDifferenceSets.EvenRows

-- one kernel check at a time: each search batch holds up to ~2 GB
set_option Elab.async false

/-- N20961 SDS(280,252,216,[280]): `L = ZMod 2 × Grp [5]`, `c = 14`, `Q = 1521`,
`t = 1512`, `K = 125`, `Σ Z = ±123` (259314 search nodes). -/
def n20961Row : Row := ⟨20961, [280], 252, 216⟩

/-- N20961's certificate. -/
def n20961Cert : EvenCert :=
  ⟨2, 2, 246, 125, [5], [[1], [1]], [[5], [16]]⟩

theorem n20961_ok : n20961Cert.Ok n20961Row := by decide +kernel

theorem n20961_pos : ∀ d ∈ n20961Cert.r :: n20961Cert.ks, 0 < d := by decide

/-- `below` with N20961's search arguments. -/
abbrev n20961Check (p : List ℤ) : Bool :=
  below (@Indexed.size (Grp (n20961Cert.r :: n20961Cert.ks)) _ (Grp.indexed _ n20961_pos))
    (@Indexed.addIdx (Grp (n20961Cert.r :: n20961Cert.ks)) _ (Grp.indexed _ n20961_pos))
    (n20961Cert.c n20961Row)
    ((n20961Row.k + n20961Row.lam * (2 * (n20961Cert.c n20961Row : ℤ) - 1)) / 4)
    (n20961Row.lam * n20961Cert.c n20961Row / 2) n20961Cert.K (n20961Cert.s / 2)

