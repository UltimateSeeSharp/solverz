module

public import SignedDifferenceSets.EvenContraction

/-!
# N664: no SDS by C28 (the even contraction)

Its `EvenCert` (`EvenCert.Ok` by `decide +kernel`) and its search on `ZMod r × Grp ks`,
split into checks of at most 20000 nodes where larger; generated by
`solver/evenrows.py` from `x_even_contraction`'s kills.
-/

@[expose] public section

namespace SignedDifferenceSets.EvenRows

-- one kernel check at a time: each search batch holds up to ~2 GB
set_option Elab.async false

/-- N664 SDS(64,18,2,[2,32]): `L = ZMod 16 × Grp [1]`, `c = 2`, `Q = 6`,
`t = 2`, `K = 8`, `Σ Z = ±6` (19823 search nodes). -/
def n664Row : Row := ⟨664, [2, 32], 18, 2⟩

/-- N664's certificate. -/
def n664Cert : EvenCert :=
  ⟨16, 1, 12, 8, [1], [[0, 1], [0, 1]], [[0, 1], [0, 0]]⟩

theorem n664_ok : n664Cert.Ok n664Row := by decide +kernel

set_option maxRecDepth 100000 in
theorem n664_search : n664Cert.search n664Row = true := by decide +kernel

/-- N664 has no SDS (C28). -/
theorem n664_not_hasSDS (inst : Fintype (Grp [2, 32])) :
    ¬ @HasSDS (Grp [2, 32]) _ inst 18 2 :=
  EvenCert.not_hasSDS (w := n664Row) (e := n664Cert) n664_ok n664_search inst

end SignedDifferenceSets.EvenRows
