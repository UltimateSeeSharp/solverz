module

public import SignedDifferenceSets.EvenContraction

/-!
# N4712: no SDS by C28 (the even contraction)

Its `EvenCert` (`EvenCert.Ok` by `decide +kernel`) and its search on `ZMod r × Grp ks`,
split into checks of at most 20000 nodes where larger; generated by
`solver/evenrows.py` from `x_even_contraction`'s kills.
-/

@[expose] public section

namespace SignedDifferenceSets.EvenRows

-- one kernel check at a time: each search batch holds up to ~2 GB
set_option Elab.async false

/-- N4712 SDS(144,56,20,[2,72]): `L = ZMod 1 × Grp [9]`, `c = 8`, `Q = 89`,
`t = 80`, `K = 27`, `Σ Z = ±27` (33989 search nodes). -/
def n4712Row : Row := ⟨4712, [2, 72], 56, 20⟩

/-- N4712's certificate. -/
def n4712Cert : EvenCert :=
  ⟨1, 3, 54, 27, [9], [[1], [0, 1]], [[1], [0, 1]]⟩

theorem n4712_ok : n4712Cert.Ok n4712Row := by decide +kernel

theorem n4712_pos : ∀ d ∈ n4712Cert.r :: n4712Cert.ks, 0 < d := by decide

/-- `below` with N4712's search arguments. -/
abbrev n4712Check (p : List ℤ) : Bool :=
  below (@Indexed.size (Grp (n4712Cert.r :: n4712Cert.ks)) _ (Grp.indexed _ n4712_pos))
    (@Indexed.addIdx (Grp (n4712Cert.r :: n4712Cert.ks)) _ (Grp.indexed _ n4712_pos))
    (n4712Cert.c n4712Row)
    ((n4712Row.k + n4712Row.lam * (2 * (n4712Cert.c n4712Row : ℤ) - 1)) / 4)
    (n4712Row.lam * n4712Cert.c n4712Row / 2) n4712Cert.K (n4712Cert.s / 2) p

/-- Prefixes, batch 0. -/
def n4712Batch0 : List (List ℤ) :=
  [[1, -1],
    [1, 0],
    [1, 1],
    [2, -2],
    [2, -1],
    [2, 0],
    [2, 1],
    [2, 2],
    [3, -3],
    [3, -2],
    [3, -1],
    [3, 0],
    [3, 1],
    [3, 2],
    [3, 3],
    [4, -4],
    [4, -3],
    [4, -2],
    [4, -1],
    [4, 0],
    [4, 1],
    [4, 2]]

set_option maxRecDepth 100000 in
theorem n4712_below0 : ∀ p ∈ n4712Batch0, n4712Check p = true := by
  decide +kernel

/-- Prefixes, batch 1. -/
def n4712Batch1 : List (List ℤ) :=
  [[4, 3],
    [4, 4],
    [5, -5],
    [5, -4],
    [5, -3],
    [5, -2],
    [5, -1],
    [5, 0],
    [5, 1],
    [5, 2]]

set_option maxRecDepth 100000 in
theorem n4712_below1 : ∀ p ∈ n4712Batch1, n4712Check p = true := by
  decide +kernel

/-- Prefixes, batch 2. -/
def n4712Batch2 : List (List ℤ) :=
  [[5, 3],
    [5, 4],
    [5, 5]]

set_option maxRecDepth 100000 in
theorem n4712_below2 : ∀ p ∈ n4712Batch2, n4712Check p = true := by
  decide +kernel

/-- The prefixes of 2 coordinates (33989 nodes in 3 batches of at most
20000). -/
def n4712Prefixes : List (List ℤ) :=
  n4712Batch0 ++ n4712Batch1 ++ n4712Batch2

set_option maxHeartbeats 4000000 in
-- elaborating the join of many batches needs more than the default heartbeats
theorem n4712_search : n4712Cert.search n4712Row = true :=
  onGrp_of n4712_pos (noVector_of_top (P := n4712Prefixes) (d := 1) (by decide)
    (by decide +kernel) fun p hp => by
      simp only [n4712Prefixes, List.mem_append, or_assoc] at hp
      rcases hp with h | h | h
      exacts [n4712_below0 p h, n4712_below1 p h, n4712_below2 p h])

/-- N4712 has no SDS (C28). -/
theorem n4712_not_hasSDS (inst : Fintype (Grp [2, 72])) :
    ¬ @HasSDS (Grp [2, 72]) _ inst 56 20 :=
  EvenCert.not_hasSDS (w := n4712Row) (e := n4712Cert) n4712_ok n4712_search inst

end SignedDifferenceSets.EvenRows
