module

public import SignedDifferenceSets.EvenContraction

/-!
# N763: no SDS by C28 (the even contraction)

Its `EvenCert` (`EvenCert.Ok` by `decide +kernel`) and its search on `ZMod r × Grp ks`,
split into checks of at most 20000 nodes where larger; generated by
`solver/evenrows.py` from `x_even_contraction`'s kills.
-/

@[expose] public section

namespace SignedDifferenceSets.EvenRows

-- one kernel check at a time: each search batch holds up to ~2 GB
set_option Elab.async false

/-- N763 SDS(64,58,42,[2,32]): `L = ZMod 16 × Grp [1]`, `c = 2`, `Q = 46`,
`t = 42`, `K = 28`, `Σ Z = ±26` (66854 search nodes). -/
def n763Row : Row := ⟨763, [2, 32], 58, 42⟩

/-- N763's certificate. -/
def n763Cert : EvenCert :=
  ⟨16, 1, 52, 28, [1], [[0, 1], [0, 1]], [[0, 1], [0, 0]]⟩

theorem n763_ok : n763Cert.Ok n763Row := by decide +kernel

theorem n763_pos : ∀ d ∈ n763Cert.r :: n763Cert.ks, 0 < d := by decide

/-- `below` with N763's search arguments. -/
abbrev n763Check (p : List ℤ) : Bool :=
  below (@Indexed.size (Grp (n763Cert.r :: n763Cert.ks)) _ (Grp.indexed _ n763_pos))
    (@Indexed.addIdx (Grp (n763Cert.r :: n763Cert.ks)) _ (Grp.indexed _ n763_pos))
    (n763Cert.c n763Row)
    ((n763Row.k + n763Row.lam * (2 * (n763Cert.c n763Row : ℤ) - 1)) / 4)
    (n763Row.lam * n763Cert.c n763Row / 2) n763Cert.K (n763Cert.s / 2) p

/-- Prefixes, batch 0. -/
def n763Batch0 : List (List ℤ) :=
  [[1, 1, 1, -1],
    [1, 1, 1, 0],
    [1, 1, 1, 1],
    [2, 0, 1, -2],
    [2, 0, 1, -1],
    [2, 0, 1, 0],
    [2, 0, 1, 1],
    [2, 0, 1, 2],
    [2, 0, 2, -2],
    [2, 0, 2, -1],
    [2, 0, 2, 0],
    [2, 0, 2, 1],
    [2, 0, 2, 2],
    [2, 1, 0, -2],
    [2, 1, 0, -1],
    [2, 1, 0, 0],
    [2, 1, 0, 1],
    [2, 1, 0, 2],
    [2, 1, 1, -2],
    [2, 1, 1, -1],
    [2, 1, 1, 0],
    [2, 1, 1, 1],
    [2, 1, 1, 2],
    [2, 1, 2, -2],
    [2, 1, 2, -1],
    [2, 1, 2, 0],
    [2, 1, 2, 1]]

set_option maxRecDepth 100000 in
theorem n763_below0 : ∀ p ∈ n763Batch0, n763Check p = true := by
  decide +kernel

/-- Prefixes, batch 1. -/
def n763Batch1 : List (List ℤ) :=
  [[2, 1, 2, 2],
    [2, 2, 0, -2],
    [2, 2, 0, -1],
    [2, 2, 0, 0],
    [2, 2, 0, 1],
    [2, 2, 0, 2],
    [2, 2, 1, -2],
    [2, 2, 1, -1],
    [2, 2, 1, 0],
    [2, 2, 1, 1]]

set_option maxRecDepth 100000 in
theorem n763_below1 : ∀ p ∈ n763Batch1, n763Check p = true := by
  decide +kernel

/-- Prefixes, batch 2. -/
def n763Batch2 : List (List ℤ) :=
  [[2, 2, 1, 2],
    [2, 2, 2, -2],
    [2, 2, 2, -1],
    [2, 2, 2, 0]]

set_option maxRecDepth 100000 in
theorem n763_below2 : ∀ p ∈ n763Batch2, n763Check p = true := by
  decide +kernel

/-- Prefixes, batch 3. -/
def n763Batch3 : List (List ℤ) :=
  [[2, 2, 2, 1]]

set_option maxRecDepth 100000 in
theorem n763_below3 : ∀ p ∈ n763Batch3, n763Check p = true := by
  decide +kernel

/-- Prefixes, batch 4. -/
def n763Batch4 : List (List ℤ) :=
  [[2, 2, 2, 2]]

set_option maxRecDepth 100000 in
theorem n763_below4 : ∀ p ∈ n763Batch4, n763Check p = true := by
  decide +kernel

/-- The prefixes of 4 coordinates (66854 nodes in 5 batches of at most
20000). -/
def n763Prefixes : List (List ℤ) :=
  n763Batch0 ++ n763Batch1 ++ n763Batch2 ++ n763Batch3 ++ n763Batch4

theorem n763_search : n763Cert.search n763Row = true :=
  onGrp_of n763_pos (noVector_of_top (P := n763Prefixes) (d := 3) (by decide)
    (by decide +kernel) fun p hp => by
      simp only [n763Prefixes, List.mem_append, or_assoc] at hp
      rcases hp with h | h | h | h | h
      exacts [n763_below0 p h, n763_below1 p h, n763_below2 p h, n763_below3 p h,
        n763_below4 p h])

/-- N763 has no SDS (C28). -/
theorem n763_not_hasSDS (inst : Fintype (Grp [2, 32])) :
    ¬ @HasSDS (Grp [2, 32]) _ inst 58 42 :=
  EvenCert.not_hasSDS (w := n763Row) (e := n763Cert) n763_ok n763_search inst

end SignedDifferenceSets.EvenRows
