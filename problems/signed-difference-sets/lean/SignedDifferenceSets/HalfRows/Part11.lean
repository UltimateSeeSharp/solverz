    (c := ⟨1, 14, [145], [[1], [1]], [[145], [146]], [145], 52, 3, [[1], [1]], [[0], [1]]⟩)
    (by decide +kernel) inst'
    (not_hasSDS_of_orbitRow' (ms := [145]) (t := 7) (s := 22) (by decide +kernel) inst')
    inst

