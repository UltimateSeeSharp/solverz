/-- N2233: halved SDS(52,25,16,[52]), not in the table, has no SDS. -/
theorem n2233_not_hasSDS (inst : Fintype (Grp [104])) :
    ¬ @HasSDS (Grp [104]) _ inst 68 32 :=
  have inst' : Fintype (Grp [52]) := Grp.fintype _ (by decide)
  HalfCert.not_hasSDS (w := ⟨2233, [104], 68, 32⟩)
    (c := ⟨4, 6, [13], [[1], [1]], [[65], [40]], [52], 25, 16, [[1], [1]], [[13], [40]]⟩)
    (by decide +kernel) inst'
    (not_hasSDS_of_orbitRow' (ms := [52]) (t := 3) (s := 29) (by decide +kernel) inst')
    inst

