/-- N2410: halved SDS(54,29,20,[3, 18]), not in the table, has no SDS. -/
theorem n2410_not_hasSDS (inst : Fintype (Grp [3, 36])) :
    ¬ @HasSDS (Grp [3, 36]) _ inst 76 40 :=
  have inst' : Fintype (Grp [3, 18]) := Grp.fintype _ (by decide)
  HalfCert.not_hasSDS (w := ⟨2410, [3, 36], 76, 40⟩)
    (c := ⟨2, 3, [3, 9], [[0, 1], [1], [0, 1]], [[0, 9], [1], [0, 28]], [3, 18], 29, 20, [[0, 1],
      [1], [0, 1]], [[0, 9], [1], [0, 10]]⟩)
    (by decide +kernel) inst'
    (McCert.not_hasSDS (r := ⟨0, [3, 18], 29, 20⟩) (c := ⟨⟨3, 1, 1, [1, 2], 33⟩, [⟨0, 1, 0, 1⟩, ⟨0,
      -1, 0, 1⟩]⟩) (by decide +kernel) inst')
    inst

