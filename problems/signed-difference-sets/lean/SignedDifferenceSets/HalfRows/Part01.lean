/-- N935: halved row N171 SDS(36,11,2,[36]) has no SDS. -/
theorem n935_not_hasSDS (inst : Fintype (Grp [72])) :
    ¬ @HasSDS (Grp [72]) _ inst 40 4 :=
  have inst' : Fintype (Grp [36]) := Grp.fintype _ (by decide)
  HalfCert.not_hasSDS (w := ⟨935, [72], 40, 4⟩)
    (c := ⟨4, 3, [9], [[1], [1]], [[9], [64]], [36], 11, 2, [[1], [1]], [[9], [28]]⟩)
    (by decide +kernel) inst'
    (MaRowCert.not_hasSDS maRule (w := ⟨171, [36], 11, 2⟩) (c := ⟨3, 3, 1, 2, 1, [4], [[1], [1]],
      [[28], [9]]⟩) (by decide +kernel) (MaRows.cycloFacts_of_mem_maPairs (pr := (3, 3)) (by
      decide)) inst')
    inst

