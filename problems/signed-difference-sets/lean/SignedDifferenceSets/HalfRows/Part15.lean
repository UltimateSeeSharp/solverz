/-- N52484: halved SDS(216,139,114,[3, 72]), not in the table, has no SDS. -/
theorem n52484_not_hasSDS (inst : Fintype (Grp [3, 144])) :
    ¬ @HasSDS (Grp [3, 144]) _ inst 328 228 :=
  have inst' : Fintype (Grp [3, 72]) := Grp.fintype _ (by decide)
  HalfCert.not_hasSDS (w := ⟨52484, [3, 144], 328, 228⟩)
    (c := ⟨8, 3, [3, 9], [[0, 1], [1], [0, 1]], [[0, 81], [1], [0, 64]], [3, 72], 139, 114, [[0,
      1], [1], [0, 1]], [[0, 9], [1], [0, 64]]⟩)
    (by decide +kernel) inst'
    (McCert.not_hasSDS (r := ⟨0, [3, 72], 139, 114⟩) (c := ⟨⟨5, 1, 1, [1, 2], 157⟩, [⟨0, 1, 0, 1⟩,
      ⟨0, -1, 0, 1⟩]⟩) (by decide +kernel) inst')
    inst

