/-- N9541: halved SDS(99,49,24,[99]), not in the table, has no SDS. -/
theorem n9541_not_hasSDS (inst : Fintype (Grp [198])) :
    ¬ @HasSDS (Grp [198]) _ inst 148 48 :=
  have inst' : Fintype (Grp [99]) := Grp.fintype _ (by decide)
  HalfCert.not_hasSDS (w := ⟨9541, [198], 148, 48⟩)
    (c := ⟨1, 15, [99], [[1], [1]], [[99], [100]], [99], 49, 24, [[1], [1]], [[0], [1]]⟩)
    (by decide +kernel) inst'
    (not_hasSDS_of_orbitRow' (ms := [99]) (t := 5) (s := 49) (by decide +kernel) inst')
    inst

