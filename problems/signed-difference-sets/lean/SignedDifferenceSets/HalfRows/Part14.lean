    (MarkedCountsRows.part01_not_hasSDS (x := (⟨10512, [208], 27, 2⟩, ⟨⟨5, 1, 2, [26], 21⟩, [⟨4,
      -3, 24, 25⟩, ⟨4, 3, 24, 25⟩]⟩)) (by decide +kernel) inst')
    inst

