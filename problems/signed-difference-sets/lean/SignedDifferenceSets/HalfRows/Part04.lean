/-- N4713: halved SDS(72,19,10,[3, 24]), not in the table, has no SDS. -/
theorem n4713_not_hasSDS (inst : Fintype (Grp [3, 48])) :
    ¬ @HasSDS (Grp [3, 48]) _ inst 56 20 :=
  have inst' : Fintype (Grp [3, 24]) := Grp.fintype _ (by decide)
  HalfCert.not_hasSDS (w := ⟨4713, [3, 48], 56, 20⟩)
    (c := ⟨8, 1, [3, 3], [[0, 1], [1], [0, 1]], [[0, 33], [1], [0, 16]], [3, 24], 19, 10, [[0, 1],
      [1], [0, 1]], [[0, 9], [1], [0, 16]]⟩)
    (by decide +kernel) inst'
    (McCert.not_hasSDS (r := ⟨0, [3, 24], 19, 10⟩) (c := ⟨⟨3, 1, 1, [1, 2], 27⟩, [⟨0, 1, 0, 1⟩, ⟨0,
      -1, 0, 1⟩]⟩) (by decide +kernel) inst')
    inst

