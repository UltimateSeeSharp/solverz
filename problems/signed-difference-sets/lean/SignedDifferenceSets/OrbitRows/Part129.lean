  decide +kernel

/-- N1472: 15 orbits of x ↦ 16x, 1980 sign choices to evaluate, 29110 nodes; split at depth 4 into 4
slices. -/
theorem n1472_not_hasSDS : ¬ HasSDS (ZMod 87) 31 3 :=
  not_hasSDS_of_orbitSlices' (ms := [87]) (t := 16) (s := 17) (by decide +kernel)
    (orbitExhaust_of_slices (ms := [87]) (k := 31) (lam := 3) (t := 16)
      (s := 17) (d := 4)
      [14, 21, 23, 24]
      (by decide +kernel) <|
      .cons n1472_slice0 <|
      .cons n1472_slice1 <|
      .cons n1472_slice2 <|
      .cons n1472_slice3 <|
      .single) _

