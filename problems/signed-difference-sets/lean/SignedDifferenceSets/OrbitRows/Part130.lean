theorem n21593_slice5 : orbitSlice [287] 126 45 3 114 4 9 11 = true := by
  decide +kernel

theorem n21593_slice6 : orbitSlice [287] 126 45 3 114 4 11 12 = true := by
  decide +kernel

/-- N21593: 17 orbits of x ↦ 3x, 2352 sign choices to evaluate, 32923 nodes; split at depth 4 into 7
slices. -/
theorem n21593_not_hasSDS : ¬ HasSDS (ZMod 287) 126 45 :=
  not_hasSDS_of_orbitSlices' (ms := [287]) (t := 3) (s := 114) (by decide +kernel)
    (orbitExhaust_of_slices (ms := [287]) (k := 126) (lam := 45) (t := 3)
      (s := 114) (d := 4)
      [3, 5, 6, 8, 9, 11, 12]
      (by decide +kernel) <|
      .cons n21593_slice0 <|
      .cons n21593_slice1 <|
      .cons n21593_slice2 <|
      .cons n21593_slice3 <|
      .cons n21593_slice4 <|
      .cons n21593_slice5 <|
      .cons n21593_slice6 <|
      .single) _

