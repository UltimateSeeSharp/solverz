module

public import SignedDifferenceSets.CosetSearch

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 05

8 open rows (N3312 to N15211 in search order), each closed by C16 for squarefree n
(`not_hasSDS_of_cosetRow`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n3312_slice0 : cosetSlice [1, 25] 5 97 66 6 91 1 0 2 = true := by
  decide +kernel

theorem n3312_slice1 : cosetSlice [1, 25] 5 97 66 6 91 1 2 4 = true := by
  decide +kernel

/-- N3312: H = ZMod 1 × ZMod 25 (c = 5), x ↦ 6x, 9 classes, 30854 nodes; split at depth 1 into 2
slices. -/
theorem n3312_not_hasSDS : ¬ HasSDS (ZMod 5 × ZMod 25) 97 66 :=
  not_hasSDS_of_cosetRow (ms := [5, 25]) (ds := [1, 25]) (c := 5) (t := 6) (s := 91)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 25]) (c := 5) (k := 97)
      (lam := 66) (t := 6) (s := 91) (d := 1)
      [2, 4]
      (by decide +kernel) <|
      .cons n3312_slice0 <|
      .cons n3312_slice1 <|
      .single) _

