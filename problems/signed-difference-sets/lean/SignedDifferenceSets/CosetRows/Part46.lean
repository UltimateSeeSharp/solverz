@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n24504_slice0 : cosetSlice [43] 7 256 44 4 116 1 0 5 = true := by
  decide +kernel

theorem n24504_slice1 : cosetSlice [43] 7 256 44 4 116 1 5 8 = true := by
  decide +kernel

theorem n24504_slice2 : cosetSlice [43] 7 256 44 4 116 1 8 10 = true := by
  decide +kernel

/-- N24504: H = ZMod 43 (c = 7), x ↦ 4x, 7 classes, 51081 nodes; split at depth 1 into 3 slices. -/
theorem n24504_not_hasSDS : ¬ HasSDS (ZMod 301) 256 44 :=
  not_hasSDS_of_cosetRow' (ms := [301]) (ds := [43]) (c := 7) (t := 4) (s := 116)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [43]) (c := 7) (k := 256)
      (lam := 44) (t := 4) (s := 116) (d := 1)
      [5, 8, 10]
      (by decide +kernel) <|
      .cons n24504_slice0 <|
      .cons n24504_slice1 <|
      .cons n24504_slice2 <|
      .single) _

