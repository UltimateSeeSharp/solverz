/-- N14753: H = ZMod 1 × ZMod 1 × ZMod 27 (c = 9), x ↦ 22x, 7 classes, 265961 nodes; split at depth
2 into 13 slices. -/
theorem n14753_not_hasSDS : ¬ HasSDS (ZMod 3 × ZMod 3 × ZMod 27) 158 1 :=
  not_hasSDS_of_cosetRow (ms := [3, 3, 27]) (ds := [1, 1, 27]) (c := 9) (t := 22) (s := 20)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 1, 27]) (c := 9) (k := 158)
      (lam := 1) (t := 22) (s := 20) (d := 2)
      [5, 8, 10, 11, 12, 15, 16, 17, 20, 21, 22, 25, 29]
      (by decide +kernel) <|
      .cons n14753_slice0 <|
      .cons n14753_slice1 <|
      .cons n14753_slice2 <|
      .cons n14753_slice3 <|
      .cons n14753_slice4 <|
      .cons n14753_slice5 <|
      .cons n14753_slice6 <|
      .cons n14753_slice7 <|
      .cons n14753_slice8 <|
      .cons n14753_slice9 <|
      .cons n14753_slice10 <|
      .cons n14753_slice11 <|
      .cons n14753_slice12 <|
      .single) _

end SignedDifferenceSets.CosetRows
