module

public import SignedDifferenceSets.CosetSearch

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 23

2 open rows (N23893 to N15126 in search order), each closed by C16 for squarefree n
(`not_hasSDS_of_cosetRow`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n23893_slice0 : cosetSlice [27] 11 268 111 22 182 2 0 9 = true := by
  decide +kernel

theorem n23893_slice1 : cosetSlice [27] 11 268 111 22 182 2 9 12 = true := by
  decide +kernel

theorem n23893_slice2 : cosetSlice [27] 11 268 111 22 182 2 12 16 = true := by
  decide +kernel

theorem n23893_slice3 : cosetSlice [27] 11 268 111 22 182 2 16 17 = true := by
  decide +kernel

theorem n23893_slice4 : cosetSlice [27] 11 268 111 22 182 2 17 21 = true := by
  decide +kernel

theorem n23893_slice5 : cosetSlice [27] 11 268 111 22 182 2 21 23 = true := by
  decide +kernel

theorem n23893_slice6 : cosetSlice [27] 11 268 111 22 182 2 23 29 = true := by
  decide +kernel

/-- N23893: H = ZMod 27 (c = 11), x ↦ 22x, 7 classes, 162257 nodes; split at depth 2 into 7 slices.
-/
theorem n23893_not_hasSDS : ¬ HasSDS (ZMod 297) 268 111 :=
  not_hasSDS_of_cosetRow (ms := [297]) (ds := [27]) (c := 11) (t := 22) (s := 182)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [27]) (c := 11) (k := 268)
      (lam := 111) (t := 22) (s := 182) (d := 2)
      [9, 12, 16, 17, 21, 23, 29]
      (by decide +kernel) <|
      .cons n23893_slice0 <|
      .cons n23893_slice1 <|
      .cons n23893_slice2 <|
      .cons n23893_slice3 <|
      .cons n23893_slice4 <|
      .cons n23893_slice5 <|
      .cons n23893_slice6 <|
      .single) _

theorem n15126_slice0 : cosetSlice [1, 81] 3 234 5 67 38 2 0 4 = true := by
  decide +kernel

theorem n15126_slice1 : cosetSlice [1, 81] 3 234 5 67 38 2 4 5 = true := by
  decide +kernel

theorem n15126_slice2 : cosetSlice [1, 81] 3 234 5 67 38 2 5 6 = true := by
  decide +kernel

theorem n15126_slice3 : cosetSlice [1, 81] 3 234 5 67 38 2 6 7 = true := by
  decide +kernel

theorem n15126_slice4 : cosetSlice [1, 81] 3 234 5 67 38 2 7 8 = true := by
  decide +kernel

theorem n15126_slice5 : cosetSlice [1, 81] 3 234 5 67 38 2 8 9 = true := by
  decide +kernel

theorem n15126_slice6 : cosetSlice [1, 81] 3 234 5 67 38 2 9 11 = true := by
  decide +kernel

theorem n15126_slice7 : cosetSlice [1, 81] 3 234 5 67 38 2 11 12 = true := by
  decide +kernel

theorem n15126_slice8 : cosetSlice [1, 81] 3 234 5 67 38 2 12 14 = true := by
  decide +kernel

/-- N15126: H = ZMod 1 × ZMod 81 (c = 3), x ↦ 67x, 9 classes, 181557 nodes; split at depth 2 into 9
slices. -/
theorem n15126_not_hasSDS : ¬ HasSDS (ZMod 3 × ZMod 81) 234 5 :=
  not_hasSDS_of_cosetRow (ms := [3, 81]) (ds := [1, 81]) (c := 3) (t := 67) (s := 38)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 81]) (c := 3) (k := 234)
      (lam := 5) (t := 67) (s := 38) (d := 2)
      [4, 5, 6, 7, 8, 9, 11, 12, 14]
      (by decide +kernel) <|
      .cons n15126_slice0 <|
      .cons n15126_slice1 <|
      .cons n15126_slice2 <|
      .cons n15126_slice3 <|
      .cons n15126_slice4 <|
      .cons n15126_slice5 <|
      .cons n15126_slice6 <|
      .cons n15126_slice7 <|
      .cons n15126_slice8 <|
      .single) _

end SignedDifferenceSets.CosetRows
