  decide +kernel

theorem n20651_slice5 : cosetSlice [31] 9 170 7 8 46 1 8 10 = true := by
  decide +kernel

/-- N20651: H = ZMod 31 (c = 9), x ↦ 8x, 7 classes, 76261 nodes; split at depth 1 into 6 slices. -/
theorem n20651_not_hasSDS : ¬ HasSDS (ZMod 279) 170 7 :=
  not_hasSDS_of_cosetRow (ms := [279]) (ds := [31]) (c := 9) (t := 8) (s := 46)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [31]) (c := 9) (k := 170)
      (lam := 7) (t := 8) (s := 46) (d := 1)
      [3, 4, 5, 6, 8, 10]
      (by decide +kernel) <|
      .cons n20651_slice0 <|
      .cons n20651_slice1 <|
      .cons n20651_slice2 <|
      .cons n20651_slice3 <|
      .cons n20651_slice4 <|
      .cons n20651_slice5 <|
      .single) _

