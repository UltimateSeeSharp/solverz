module

public import SignedDifferenceSets.CosetSearch

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 16

3 open rows (N20651 to N45355 in search order), each closed by C16 for squarefree n
(`not_hasSDS_of_cosetRow`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n20651_slice0 : cosetSlice [31] 9 170 7 8 46 1 0 3 = true := by
  decide +kernel

theorem n20651_slice1 : cosetSlice [31] 9 170 7 8 46 1 3 4 = true := by
  decide +kernel

theorem n20651_slice2 : cosetSlice [31] 9 170 7 8 46 1 4 5 = true := by
  decide +kernel

