module

public import SignedDifferenceSets.CosetSearchWitt

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 50

3 open rows (N25483 to N32492 in search order), each closed by C10 for every n
(`not_hasSDS_of_cosetRow'`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n25483_slice0 : cosetSlice [1, 77] 4 176 32 4 100 2 0 9 = true := by
  decide +kernel

theorem n25483_slice1 : cosetSlice [1, 77] 4 176 32 4 100 2 9 14 = true := by
  decide +kernel

theorem n25483_slice2 : cosetSlice [1, 77] 4 176 32 4 100 2 14 17 = true := by
  decide +kernel

theorem n25483_slice3 : cosetSlice [1, 77] 4 176 32 4 100 2 17 23 = true := by
  decide +kernel

/-- N25483: H = ZMod 1 × ZMod 77 (c = 4), x ↦ 4x, 9 classes, 86398 nodes; split at depth 2 into 4
slices. -/
theorem n25483_not_hasSDS : ¬ HasSDS (ZMod 2 × ZMod 154) 176 32 :=
  not_hasSDS_of_cosetRow' (ms := [2, 154]) (ds := [1, 77]) (c := 4) (t := 4) (s := 100)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 77]) (c := 4) (k := 176)
      (lam := 32) (t := 4) (s := 100) (d := 2)
      [9, 14, 17, 23]
      (by decide +kernel) <|
      .cons n25483_slice0 <|
      .cons n25483_slice1 <|
      .cons n25483_slice2 <|
      .cons n25483_slice3 <|
      .single) _

theorem n25484_slice0 : cosetSlice [77] 4 176 32 4 100 2 0 9 = true := by
  decide +kernel

theorem n25484_slice1 : cosetSlice [77] 4 176 32 4 100 2 9 14 = true := by
  decide +kernel

theorem n25484_slice2 : cosetSlice [77] 4 176 32 4 100 2 14 17 = true := by
  decide +kernel

theorem n25484_slice3 : cosetSlice [77] 4 176 32 4 100 2 17 23 = true := by
  decide +kernel

/-- N25484: H = ZMod 77 (c = 4), x ↦ 4x, 9 classes, 86398 nodes; split at depth 2 into 4 slices. -/
theorem n25484_not_hasSDS : ¬ HasSDS (ZMod 308) 176 32 :=
  not_hasSDS_of_cosetRow' (ms := [308]) (ds := [77]) (c := 4) (t := 4) (s := 100)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [77]) (c := 4) (k := 176)
      (lam := 32) (t := 4) (s := 100) (d := 2)
      [9, 14, 17, 23]
      (by decide +kernel) <|
      .cons n25484_slice0 <|
      .cons n25484_slice1 <|
      .cons n25484_slice2 <|
      .cons n25484_slice3 <|
      .single) _

theorem n32492_slice0 : cosetSlice [69] 5 196 72 4 158 2 0 12 = true := by
  decide +kernel

theorem n32492_slice1 : cosetSlice [69] 5 196 72 4 158 2 12 17 = true := by
  decide +kernel

theorem n32492_slice2 : cosetSlice [69] 5 196 72 4 158 2 17 22 = true := by
  decide +kernel

theorem n32492_slice3 : cosetSlice [69] 5 196 72 4 158 2 22 30 = true := by
  decide +kernel

/-- N32492: H = ZMod 69 (c = 5), x ↦ 4x, 9 classes, 92535 nodes; split at depth 2 into 4 slices. -/
theorem n32492_not_hasSDS : ¬ HasSDS (ZMod 345) 196 72 :=
  not_hasSDS_of_cosetRow' (ms := [345]) (ds := [69]) (c := 5) (t := 4) (s := 158)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [69]) (c := 5) (k := 196)
      (lam := 72) (t := 4) (s := 158) (d := 2)
      [12, 17, 22, 30]
      (by decide +kernel) <|
      .cons n32492_slice0 <|
      .cons n32492_slice1 <|
      .cons n32492_slice2 <|
      .cons n32492_slice3 <|
      .single) _

end SignedDifferenceSets.CosetRows
