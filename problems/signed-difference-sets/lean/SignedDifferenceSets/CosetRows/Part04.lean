module

public import SignedDifferenceSets.CosetSearch

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 04

10 open rows (N20592 to N14994 in search order), each closed by C16 for squarefree n
(`not_hasSDS_of_cosetRow`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n20592_slice0 : cosetSlice [1, 31] 9 113 4 16 35 1 0 6 = true := by
  decide +kernel

theorem n20592_slice1 : cosetSlice [1, 31] 9 113 4 16 35 1 6 9 = true := by
  decide +kernel

/-- N20592: H = ZMod 1 × ZMod 31 (c = 9), x ↦ 16x, 7 classes, 25683 nodes; split at depth 1 into 2
slices. -/
theorem n20592_not_hasSDS : ¬ HasSDS (ZMod 3 × ZMod 93) 113 4 :=
  not_hasSDS_of_cosetRow (ms := [3, 93]) (ds := [1, 31]) (c := 9) (t := 16) (s := 35)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 31]) (c := 9) (k := 113)
      (lam := 4) (t := 16) (s := 35) (d := 1)
      [6, 9]
      (by decide +kernel) <|
      .cons n20592_slice0 <|
      .cons n20592_slice1 <|
      .single) _

