module

public import SignedDifferenceSets.CosetSearch

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 19

2 open rows (N12458 to N55105 in search order), each closed by C16 for squarefree n
(`not_hasSDS_of_cosetRow`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n12458_slice0 : cosetSlice [25] 9 32 1 6 16 2 0 5 = true := by
  decide +kernel

theorem n12458_slice1 : cosetSlice [25] 9 32 1 6 16 2 5 6 = true := by
  decide +kernel

theorem n12458_slice2 : cosetSlice [25] 9 32 1 6 16 2 6 8 = true := by
  decide +kernel

theorem n12458_slice3 : cosetSlice [25] 9 32 1 6 16 2 8 9 = true := by
  decide +kernel

theorem n12458_slice4 : cosetSlice [25] 9 32 1 6 16 2 9 10 = true := by
  decide +kernel

theorem n12458_slice5 : cosetSlice [25] 9 32 1 6 16 2 10 14 = true := by
  decide +kernel

/-- N12458: H = ZMod 25 (c = 9), x ↦ 6x, 9 classes, 68904 nodes; split at depth 2 into 6 slices. -/
theorem n12458_not_hasSDS : ¬ HasSDS (ZMod 225) 32 1 :=
  not_hasSDS_of_cosetRow (ms := [225]) (ds := [25]) (c := 9) (t := 6) (s := 16)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [25]) (c := 9) (k := 32)
      (lam := 1) (t := 6) (s := 16) (d := 2)
      [5, 6, 8, 9, 10, 14]
      (by decide +kernel) <|
      .cons n12458_slice0 <|
      .cons n12458_slice1 <|
      .cons n12458_slice2 <|
      .cons n12458_slice3 <|
      .cons n12458_slice4 <|
      .cons n12458_slice5 <|
      .single) _

theorem n55105_slice0 : cosetSlice [1, 9] 49 440 109 7 220 1 0 4 = true := by
  decide +kernel

theorem n55105_slice1 : cosetSlice [1, 9] 49 440 109 7 220 1 4 6 = true := by
  decide +kernel

theorem n55105_slice2 : cosetSlice [1, 9] 49 440 109 7 220 1 6 8 = true := by
  decide +kernel

theorem n55105_slice3 : cosetSlice [1, 9] 49 440 109 7 220 1 8 10 = true := by
  decide +kernel

theorem n55105_slice4 : cosetSlice [1, 9] 49 440 109 7 220 1 10 12 = true := by
  decide +kernel

theorem n55105_slice5 : cosetSlice [1, 9] 49 440 109 7 220 1 12 16 = true := by
  decide +kernel

/-- N55105: H = ZMod 1 × ZMod 9 (c = 49), x ↦ 7x, 5 classes, 99240 nodes; split at depth 1 into 6
slices. -/
theorem n55105_not_hasSDS : ¬ HasSDS (ZMod 7 × ZMod 63) 440 109 :=
  not_hasSDS_of_cosetRow (ms := [7, 63]) (ds := [1, 9]) (c := 49) (t := 7) (s := 220)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 9]) (c := 49) (k := 440)
      (lam := 109) (t := 7) (s := 220) (d := 1)
      [4, 6, 8, 10, 12, 16]
      (by decide +kernel) <|
      .cons n55105_slice0 <|
      .cons n55105_slice1 <|
      .cons n55105_slice2 <|
      .cons n55105_slice3 <|
      .cons n55105_slice4 <|
      .cons n55105_slice5 <|
      .single) _

end SignedDifferenceSets.CosetRows
