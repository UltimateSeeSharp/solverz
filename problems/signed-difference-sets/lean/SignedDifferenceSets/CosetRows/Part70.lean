/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 70

1 open rows (N28405 to N28405 in search order), each closed by C10 for every n
(`not_hasSDS_of_cosetRow'`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n28405_slice0 : cosetSlice [1, 81] 4 237 68 13 149 3 0 11 = true := by
  decide +kernel

theorem n28405_slice1 : cosetSlice [1, 81] 4 237 68 13 149 3 11 17 = true := by
  decide +kernel

theorem n28405_slice2 : cosetSlice [1, 81] 4 237 68 13 149 3 17 22 = true := by
  decide +kernel

theorem n28405_slice3 : cosetSlice [1, 81] 4 237 68 13 149 3 22 24 = true := by
  decide +kernel

theorem n28405_slice4 : cosetSlice [1, 81] 4 237 68 13 149 3 24 27 = true := by
  decide +kernel

theorem n28405_slice5 : cosetSlice [1, 81] 4 237 68 13 149 3 27 34 = true := by
  decide +kernel

theorem n28405_slice6 : cosetSlice [1, 81] 4 237 68 13 149 3 34 38 = true := by
  decide +kernel

theorem n28405_slice7 : cosetSlice [1, 81] 4 237 68 13 149 3 38 42 = true := by
  decide +kernel

/-- N28405: H = ZMod 1 × ZMod 81 (c = 4), x ↦ 13x, 9 classes, 201427 nodes; split at depth 3 into 8
slices. -/
theorem n28405_not_hasSDS : ¬ HasSDS (ZMod 2 × ZMod 162) 237 68 :=
  not_hasSDS_of_cosetRow' (ms := [2, 162]) (ds := [1, 81]) (c := 4) (t := 13) (s := 149)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 81]) (c := 4) (k := 237)
      (lam := 68) (t := 13) (s := 149) (d := 3)
      [11, 17, 22, 24, 27, 34, 38, 42]
      (by decide +kernel) <|
      .cons n28405_slice0 <|
      .cons n28405_slice1 <|
      .cons n28405_slice2 <|
      .cons n28405_slice3 <|
      .cons n28405_slice4 <|
      .cons n28405_slice5 <|
      .cons n28405_slice6 <|
      .cons n28405_slice7 <|
      .single) _

end SignedDifferenceSets.CosetRows
