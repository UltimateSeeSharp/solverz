  decide +kernel

theorem n20689_slice4 : cosetSlice [31] 9 193 36 2 101 1 7 10 = true := by
  decide +kernel

/-- N20689: H = ZMod 31 (c = 9), x ↦ 2x, 7 classes, 65839 nodes; split at depth 1 into 5 slices. -/
theorem n20689_not_hasSDS : ¬ HasSDS (ZMod 279) 193 36 :=
  not_hasSDS_of_cosetRow (ms := [279]) (ds := [31]) (c := 9) (t := 2) (s := 101)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [31]) (c := 9) (k := 193)
      (lam := 36) (t := 2) (s := 101) (d := 1)
      [3, 4, 5, 7, 10]
      (by decide +kernel) <|
      .cons n20689_slice0 <|
      .cons n20689_slice1 <|
      .cons n20689_slice2 <|
      .cons n20689_slice3 <|
      .cons n20689_slice4 <|
      .single) _

