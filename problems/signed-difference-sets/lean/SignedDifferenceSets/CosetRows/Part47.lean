module

public import SignedDifferenceSets.CosetSearchWitt

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 47

5 open rows (N13225 to N4241 in search order), each closed by C10 for every n
(`not_hasSDS_of_cosetRow'`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n13225_slice0 : cosetSlice [77] 3 164 16 4 62 1 0 2 = true := by
  decide +kernel

theorem n13225_slice1 : cosetSlice [77] 3 164 16 4 62 1 2 3 = true := by
  decide +kernel

theorem n13225_slice2 : cosetSlice [77] 3 164 16 4 62 1 3 5 = true := by
  decide +kernel

/-- N13225: H = ZMod 77 (c = 3), x ↦ 4x, 9 classes, 66461 nodes; split at depth 1 into 3 slices. -/
theorem n13225_not_hasSDS : ¬ HasSDS (ZMod 231) 164 16 :=
  not_hasSDS_of_cosetRow' (ms := [231]) (ds := [77]) (c := 3) (t := 4) (s := 62)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [77]) (c := 3) (k := 164)
      (lam := 16) (t := 4) (s := 62) (d := 1)
      [2, 3, 5]
      (by decide +kernel) <|
      .cons n13225_slice0 <|
      .cons n13225_slice1 <|
      .cons n13225_slice2 <|
      .single) _

