module

public import SignedDifferenceSets.CosetSearchWitt

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 58

3 open rows (N15905 to N21422 in search order), each closed by C10 for every n
(`not_hasSDS_of_cosetRow'`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n15905_slice0 : cosetSlice [31] 8 244 48 2 110 1 0 4 = true := by
  decide +kernel

theorem n15905_slice1 : cosetSlice [31] 8 244 48 2 110 1 4 5 = true := by
  decide +kernel

theorem n15905_slice2 : cosetSlice [31] 8 244 48 2 110 1 5 6 = true := by
  decide +kernel

theorem n15905_slice3 : cosetSlice [31] 8 244 48 2 110 1 6 7 = true := by
  decide +kernel

theorem n15905_slice4 : cosetSlice [31] 8 244 48 2 110 1 7 8 = true := by
  decide +kernel

theorem n15905_slice5 : cosetSlice [31] 8 244 48 2 110 1 8 11 = true := by
  decide +kernel

/-- N15905: H = ZMod 31 (c = 8), x ↦ 2x, 7 classes, 111301 nodes; split at depth 1 into 6 slices. -/
theorem n15905_not_hasSDS : ¬ HasSDS (ZMod 248) 244 48 :=
  not_hasSDS_of_cosetRow' (ms := [248]) (ds := [31]) (c := 8) (t := 2) (s := 110)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [31]) (c := 8) (k := 244)
      (lam := 48) (t := 2) (s := 110) (d := 1)
      [4, 5, 6, 7, 8, 11]
      (by decide +kernel) <|
      .cons n15905_slice0 <|
      .cons n15905_slice1 <|
      .cons n15905_slice2 <|
      .cons n15905_slice3 <|
      .cons n15905_slice4 <|
      .cons n15905_slice5 <|
      .single) _

