      (by decide +kernel) <|
      .cons n7724_slice0 <|
      .cons n7724_slice1 <|
      .cons n7724_slice2 <|
      .cons n7724_slice3 <|
      .cons n7724_slice4 <|
      .cons n7724_slice5 <|
      .single) _

