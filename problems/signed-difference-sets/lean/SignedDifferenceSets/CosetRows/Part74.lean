module

public import SignedDifferenceSets.CosetSearchWitt

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 74

1 open rows (N19287 to N19287 in search order), each closed by C10 for every n
(`not_hasSDS_of_cosetRow'`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n19287_slice0 : cosetSlice [45] 6 57 8 7 47 4 0 24 = true := by
  decide +kernel

theorem n19287_slice1 : cosetSlice [45] 6 57 8 7 47 4 24 49 = true := by
  decide +kernel

theorem n19287_slice2 : cosetSlice [45] 6 57 8 7 47 4 49 55 = true := by
  decide +kernel

theorem n19287_slice3 : cosetSlice [45] 6 57 8 7 47 4 55 60 = true := by
  decide +kernel

theorem n19287_slice4 : cosetSlice [45] 6 57 8 7 47 4 60 66 = true := by
  decide +kernel

theorem n19287_slice5 : cosetSlice [45] 6 57 8 7 47 4 66 71 = true := by
  decide +kernel

theorem n19287_slice6 : cosetSlice [45] 6 57 8 7 47 4 71 87 = true := by
  decide +kernel

theorem n19287_slice7 : cosetSlice [45] 6 57 8 7 47 4 87 113 = true := by
  decide +kernel

theorem n19287_slice8 : cosetSlice [45] 6 57 8 7 47 4 113 127 = true := by
  decide +kernel

theorem n19287_slice9 : cosetSlice [45] 6 57 8 7 47 4 127 131 = true := by
  decide +kernel

/-- N19287: H = ZMod 45 (c = 6), x ↦ 7x, 10 classes, 159622 nodes; split at depth 4 into 10 slices.
-/
theorem n19287_not_hasSDS : ¬ HasSDS (ZMod 270) 57 8 :=
  not_hasSDS_of_cosetRow' (ms := [270]) (ds := [45]) (c := 6) (t := 7) (s := 47)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [45]) (c := 6) (k := 57)
      (lam := 8) (t := 7) (s := 47) (d := 4)
      [24, 49, 55, 60, 66, 71, 87, 113, 127, 131]
      (by decide +kernel) <|
      .cons n19287_slice0 <|
      .cons n19287_slice1 <|
      .cons n19287_slice2 <|
      .cons n19287_slice3 <|
      .cons n19287_slice4 <|
      .cons n19287_slice5 <|
      .cons n19287_slice6 <|
      .cons n19287_slice7 <|
      .cons n19287_slice8 <|
      .cons n19287_slice9 <|
      .single) _

end SignedDifferenceSets.CosetRows
