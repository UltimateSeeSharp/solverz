module

public import SignedDifferenceSets.CosetSearchWitt

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 72

1 open rows (N12472 to N12472 in search order), each closed by C10 for every n
(`not_hasSDS_of_cosetRow'`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n12472_slice0 : cosetSlice [1, 45] 5 57 8 7 43 4 0 17 = true := by
  decide +kernel

theorem n12472_slice1 : cosetSlice [1, 45] 5 57 8 7 43 4 17 44 = true := by
  decide +kernel

theorem n12472_slice2 : cosetSlice [1, 45] 5 57 8 7 43 4 44 61 = true := by
  decide +kernel

theorem n12472_slice3 : cosetSlice [1, 45] 5 57 8 7 43 4 61 68 = true := by
  decide +kernel

theorem n12472_slice4 : cosetSlice [1, 45] 5 57 8 7 43 4 68 71 = true := by
  decide +kernel

theorem n12472_slice5 : cosetSlice [1, 45] 5 57 8 7 43 4 71 76 = true := by
  decide +kernel

theorem n12472_slice6 : cosetSlice [1, 45] 5 57 8 7 43 4 76 90 = true := by
  decide +kernel

theorem n12472_slice7 : cosetSlice [1, 45] 5 57 8 7 43 4 90 120 = true := by
  decide +kernel

theorem n12472_slice8 : cosetSlice [1, 45] 5 57 8 7 43 4 120 131 = true := by
  decide +kernel

/-- N12472: H = ZMod 1 × ZMod 45 (c = 5), x ↦ 7x, 10 classes, 156382 nodes; split at depth 4 into 9
slices. -/
theorem n12472_not_hasSDS : ¬ HasSDS (ZMod 5 × ZMod 45) 57 8 :=
  not_hasSDS_of_cosetRow' (ms := [5, 45]) (ds := [1, 45]) (c := 5) (t := 7) (s := 43)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 45]) (c := 5) (k := 57)
      (lam := 8) (t := 7) (s := 43) (d := 4)
      [17, 44, 61, 68, 71, 76, 90, 120, 131]
      (by decide +kernel) <|
      .cons n12472_slice0 <|
      .cons n12472_slice1 <|
      .cons n12472_slice2 <|
      .cons n12472_slice3 <|
      .cons n12472_slice4 <|
      .cons n12472_slice5 <|
      .cons n12472_slice6 <|
      .cons n12472_slice7 <|
      .cons n12472_slice8 <|
      .single) _

end SignedDifferenceSets.CosetRows
