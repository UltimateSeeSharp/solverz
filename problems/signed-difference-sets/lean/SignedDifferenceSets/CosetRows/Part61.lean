/-- N44059: H = ZMod 57 (c = 7), x ↦ 4x, 9 classes, 134286 nodes; split at depth 2 into 7 slices. -/
theorem n44059_not_hasSDS : ¬ HasSDS (ZMod 399) 151 51 :=
  not_hasSDS_of_cosetRow' (ms := [399]) (ds := [57]) (c := 7) (t := 4) (s := 143)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [57]) (c := 7) (k := 151)
      (lam := 51) (t := 4) (s := 143) (d := 2)
      [9, 11, 14, 17, 21, 27, 28]
      (by decide +kernel) <|
      .cons n44059_slice0 <|
      .cons n44059_slice1 <|
      .cons n44059_slice2 <|
      .cons n44059_slice3 <|
      .cons n44059_slice4 <|
      .cons n44059_slice5 <|
