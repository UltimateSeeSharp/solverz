module

public import SignedDifferenceSets.CosetSearchWitt

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 61

2 open rows (N60340 to N44059 in search order), each closed by C10 for every n
(`not_hasSDS_of_cosetRow'`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n60340_slice0 : cosetSlice [77] 6 150 6 4 54 2 0 6 = true := by
  decide +kernel

theorem n60340_slice1 : cosetSlice [77] 6 150 6 4 54 2 6 7 = true := by
  decide +kernel

theorem n60340_slice2 : cosetSlice [77] 6 150 6 4 54 2 7 8 = true := by
  decide +kernel

theorem n60340_slice3 : cosetSlice [77] 6 150 6 4 54 2 8 12 = true := by
  decide +kernel

theorem n60340_slice4 : cosetSlice [77] 6 150 6 4 54 2 12 13 = true := by
  decide +kernel

theorem n60340_slice5 : cosetSlice [77] 6 150 6 4 54 2 13 14 = true := by
  decide +kernel

theorem n60340_slice6 : cosetSlice [77] 6 150 6 4 54 2 14 18 = true := by
  decide +kernel

theorem n60340_slice7 : cosetSlice [77] 6 150 6 4 54 2 18 23 = true := by
  decide +kernel

/-- N60340: H = ZMod 77 (c = 6), x ↦ 4x, 9 classes, 130337 nodes; split at depth 2 into 8 slices. -/
theorem n60340_not_hasSDS : ¬ HasSDS (ZMod 462) 150 6 :=
  not_hasSDS_of_cosetRow' (ms := [462]) (ds := [77]) (c := 6) (t := 4) (s := 54)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [77]) (c := 6) (k := 150)
      (lam := 6) (t := 4) (s := 54) (d := 2)
      [6, 7, 8, 12, 13, 14, 18, 23]
      (by decide +kernel) <|
      .cons n60340_slice0 <|
      .cons n60340_slice1 <|
      .cons n60340_slice2 <|
      .cons n60340_slice3 <|
      .cons n60340_slice4 <|
      .cons n60340_slice5 <|
      .cons n60340_slice6 <|
      .cons n60340_slice7 <|
      .single) _

theorem n44059_slice0 : cosetSlice [57] 7 151 51 4 143 2 0 9 = true := by
  decide +kernel

theorem n44059_slice1 : cosetSlice [57] 7 151 51 4 143 2 9 11 = true := by
  decide +kernel

theorem n44059_slice2 : cosetSlice [57] 7 151 51 4 143 2 11 14 = true := by
