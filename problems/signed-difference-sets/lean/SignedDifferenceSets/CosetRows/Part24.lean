module

public import SignedDifferenceSets.CosetSearch

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 24

1 open rows (N3270 to N3270 in search order), each closed by C16 for squarefree n
(`not_hasSDS_of_cosetRow`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n3270_slice0 : cosetSlice [1, 25] 5 64 23 16 54 3 0 12 = true := by
  decide +kernel

theorem n3270_slice1 : cosetSlice [1, 25] 5 64 23 16 54 3 12 22 = true := by
  decide +kernel

theorem n3270_slice2 : cosetSlice [1, 25] 5 64 23 16 54 3 22 27 = true := by
  decide +kernel

theorem n3270_slice3 : cosetSlice [1, 25] 5 64 23 16 54 3 27 31 = true := by
  decide +kernel

theorem n3270_slice4 : cosetSlice [1, 25] 5 64 23 16 54 3 31 39 = true := by
  decide +kernel

theorem n3270_slice5 : cosetSlice [1, 25] 5 64 23 16 54 3 39 45 = true := by
  decide +kernel

theorem n3270_slice6 : cosetSlice [1, 25] 5 64 23 16 54 3 45 50 = true := by
  decide +kernel

theorem n3270_slice7 : cosetSlice [1, 25] 5 64 23 16 54 3 50 62 = true := by
  decide +kernel

/-- N3270: H = ZMod 1 × ZMod 25 (c = 5), x ↦ 16x, 9 classes, 155700 nodes; split at depth 3 into 8
slices. -/
theorem n3270_not_hasSDS : ¬ HasSDS (ZMod 5 × ZMod 25) 64 23 :=
  not_hasSDS_of_cosetRow (ms := [5, 25]) (ds := [1, 25]) (c := 5) (t := 16) (s := 54)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 25]) (c := 5) (k := 64)
      (lam := 23) (t := 16) (s := 54) (d := 3)
      [12, 22, 27, 31, 39, 45, 50, 62]
      (by decide +kernel) <|
      .cons n3270_slice0 <|
      .cons n3270_slice1 <|
      .cons n3270_slice2 <|
      .cons n3270_slice3 <|
      .cons n3270_slice4 <|
      .cons n3270_slice5 <|
      .cons n3270_slice6 <|
      .cons n3270_slice7 <|
      .single) _

end SignedDifferenceSets.CosetRows
