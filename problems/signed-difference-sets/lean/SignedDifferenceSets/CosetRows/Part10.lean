module

public import SignedDifferenceSets.CosetSearch

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 10

5 open rows (N14594 to N15181 in search order), each closed by C16 for squarefree n
(`not_hasSDS_of_cosetRow`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n14594_slice0 : cosetSlice [1, 27] 9 121 24 16 77 1 0 2 = true := by
  decide +kernel

theorem n14594_slice1 : cosetSlice [1, 27] 9 121 24 16 77 1 2 3 = true := by
  decide +kernel

theorem n14594_slice2 : cosetSlice [1, 27] 9 121 24 16 77 1 3 5 = true := by
  decide +kernel

/-- N14594: H = ZMod 1 × ZMod 27 (c = 9), x ↦ 16x, 7 classes, 64604 nodes; split at depth 1 into 3
slices. -/
theorem n14594_not_hasSDS : ¬ HasSDS (ZMod 3 × ZMod 81) 121 24 :=
  not_hasSDS_of_cosetRow (ms := [3, 81]) (ds := [1, 27]) (c := 9) (t := 16) (s := 77)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 27]) (c := 9) (k := 121)
      (lam := 24) (t := 16) (s := 77) (d := 1)
      [2, 3, 5]
      (by decide +kernel) <|
      .cons n14594_slice0 <|
      .cons n14594_slice1 <|
      .cons n14594_slice2 <|
      .single) _

