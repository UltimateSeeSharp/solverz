module

public import SignedDifferenceSets.CosetSearchWitt

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 68

1 open rows (N45788 to N45788 in search order), each closed by C10 for every n
(`not_hasSDS_of_cosetRow'`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n45788_slice0 : cosetSlice [1, 27] 15 125 1 4 23 2 0 7 = true := by
  decide +kernel

theorem n45788_slice1 : cosetSlice [1, 27] 15 125 1 4 23 2 7 9 = true := by
  decide +kernel

theorem n45788_slice2 : cosetSlice [1, 27] 15 125 1 4 23 2 9 11 = true := by
  decide +kernel

theorem n45788_slice3 : cosetSlice [1, 27] 15 125 1 4 23 2 11 13 = true := by
  decide +kernel

theorem n45788_slice4 : cosetSlice [1, 27] 15 125 1 4 23 2 13 14 = true := by
  decide +kernel

theorem n45788_slice5 : cosetSlice [1, 27] 15 125 1 4 23 2 14 18 = true := by
  decide +kernel

theorem n45788_slice6 : cosetSlice [1, 27] 15 125 1 4 23 2 18 19 = true := by
  decide +kernel

theorem n45788_slice7 : cosetSlice [1, 27] 15 125 1 4 23 2 19 23 = true := by
  decide +kernel

theorem n45788_slice8 : cosetSlice [1, 27] 15 125 1 4 23 2 23 25 = true := by
  decide +kernel

/-- N45788: H = ZMod 1 × ZMod 27 (c = 15), x ↦ 4x, 7 classes, 137974 nodes; split at depth 2 into 9
slices. -/
theorem n45788_not_hasSDS : ¬ HasSDS (ZMod 3 × ZMod 135) 125 1 :=
  not_hasSDS_of_cosetRow' (ms := [3, 135]) (ds := [1, 27]) (c := 15) (t := 4) (s := 23)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 27]) (c := 15) (k := 125)
      (lam := 1) (t := 4) (s := 23) (d := 2)
      [7, 9, 11, 13, 14, 18, 19, 23, 25]
      (by decide +kernel) <|
      .cons n45788_slice0 <|
      .cons n45788_slice1 <|
      .cons n45788_slice2 <|
      .cons n45788_slice3 <|
      .cons n45788_slice4 <|
      .cons n45788_slice5 <|
      .cons n45788_slice6 <|
      .cons n45788_slice7 <|
      .cons n45788_slice8 <|
      .single) _

end SignedDifferenceSets.CosetRows
