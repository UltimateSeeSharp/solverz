module

public import SignedDifferenceSets.CosetSearchCongr

/-!
# Rows killed by C25's coset-sum multipliers with C5's congruence (I18), part 98

1 open rows (N42350 to N42350 in search order), each closed by C25 and C5
(`not_hasSDS_of_cosetRowCongr`: self-conjugate primes of n impose nothing on t, and the coset sums
agree mod q) and the filtered coset search on a quotient of order prime to n (generated by
`solver/a7selfconj.py write-congr`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n42350_res0_slice0 :
    cosetSliceR [65] 6 372 48 3 138 2 0 2 0 7 = true := by
  decide +kernel

theorem n42350_res0_slice1 :
    cosetSliceR [65] 6 372 48 3 138 2 0 2 7 8 = true := by
  decide +kernel

theorem n42350_res0_slice2 :
    cosetSliceR [65] 6 372 48 3 138 2 0 2 8 9 = true := by
  decide +kernel

theorem n42350_res0_slice3 :
    cosetSliceR [65] 6 372 48 3 138 2 0 2 9 12 = true := by
  decide +kernel

theorem n42350_res0_slice4 :
    cosetSliceR [65] 6 372 48 3 138 2 0 2 12 13 = true := by
  decide +kernel

theorem n42350_res0_slice5 :
    cosetSliceR [65] 6 372 48 3 138 2 0 2 13 14 = true := by
  decide +kernel

theorem n42350_res0_slice6 :
    cosetSliceR [65] 6 372 48 3 138 2 0 2 14 17 = true := by
  decide +kernel

theorem n42350_res0 : cosetSearchR [65] 6 372 48 3 138 2 0 = true :=
  cosetSearchR_of_slices (ds := [65]) (c := 6) (k := 372)
    (lam := 48) (t := 3) (s := 138) (q := 2) (res := 0) (d := 2)
    [7, 8, 9, 12, 13, 14, 17]
    (by decide +kernel) <|
    .cons n42350_res0_slice0 <|
    .cons n42350_res0_slice1 <|
    .cons n42350_res0_slice2 <|
    .cons n42350_res0_slice3 <|
    .cons n42350_res0_slice4 <|
    .cons n42350_res0_slice5 <|
    .cons n42350_res0_slice6 <|
    .single

theorem n42350_res1_slice0 :
    cosetSliceR [65] 6 372 48 3 138 2 1 2 0 6 = true := by
  decide +kernel

theorem n42350_res1_slice1 :
    cosetSliceR [65] 6 372 48 3 138 2 1 2 6 9 = true := by
  decide +kernel

theorem n42350_res1_slice2 :
    cosetSliceR [65] 6 372 48 3 138 2 1 2 9 13 = true := by
  decide +kernel

theorem n42350_res1_slice3 :
    cosetSliceR [65] 6 372 48 3 138 2 1 2 13 15 = true := by
  decide +kernel

theorem n42350_res1 : cosetSearchR [65] 6 372 48 3 138 2 1 = true :=
  cosetSearchR_of_slices (ds := [65]) (c := 6) (k := 372)
    (lam := 48) (t := 3) (s := 138) (q := 2) (res := 1) (d := 2)
    [6, 9, 13, 15]
    (by decide +kernel) <|
    .cons n42350_res1_slice0 <|
    .cons n42350_res1_slice1 <|
    .cons n42350_res1_slice2 <|
    .cons n42350_res1_slice3 <|
    .single

/-- N42350: H = ZMod 65 (c = 6), x ↦ 3x, self-conjugate [2], coset sums agree mod 2 (C5), 10
classes, 141858 nodes; one search per residue. -/
theorem n42350_not_hasSDS : ¬ HasSDS (ZMod 390) 372 48 :=
  not_hasSDS_of_cosetRowCongr (ms := [390]) (ds := [65]) (c := 6) (t := 3) (s := 138) (q := 2)
    (by decide +kernel) (forall_lt_two n42350_res0 n42350_res1) _

end SignedDifferenceSets.CosetRows
