module

public import SignedDifferenceSets.CosetSearch

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 11

4 open rows (N15182 to N45477 in search order), each closed by C16 for squarefree n
(`not_hasSDS_of_cosetRow`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n15182_slice0 : cosetSlice [1, 9] 27 242 1 7 22 1 0 5 = true := by
  decide +kernel

theorem n15182_slice1 : cosetSlice [1, 9] 27 242 1 7 22 1 5 8 = true := by
  decide +kernel

theorem n15182_slice2 : cosetSlice [1, 9] 27 242 1 7 22 1 8 13 = true := by
  decide +kernel

theorem n15182_slice3 : cosetSlice [1, 9] 27 242 1 7 22 1 13 14 = true := by
  decide +kernel

/-- N15182: H = ZMod 1 × ZMod 9 (c = 27), x ↦ 7x, 5 classes, 53189 nodes; split at depth 1 into 4
slices. -/
theorem n15182_not_hasSDS : ¬ HasSDS (ZMod 3 × ZMod 81) 242 1 :=
  not_hasSDS_of_cosetRow (ms := [3, 81]) (ds := [1, 9]) (c := 27) (t := 7) (s := 22)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 9]) (c := 27) (k := 242)
      (lam := 1) (t := 7) (s := 22) (d := 1)
      [5, 8, 13, 14]
      (by decide +kernel) <|
      .cons n15182_slice0 <|
      .cons n15182_slice1 <|
      .cons n15182_slice2 <|
      .cons n15182_slice3 <|
      .single) _

