/-- N33611: H = ZMod 27 (c = 13), x ↦ 22x, 7 classes, 202970 nodes; split at depth 2 into 10 slices.
-/
theorem n33611_not_hasSDS : ¬ HasSDS (ZMod 351) 281 124 :=
  not_hasSDS_of_cosetRow (ms := [351]) (ds := [27]) (c := 13) (t := 22) (s := 209)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [27]) (c := 13) (k := 281)
      (lam := 124) (t := 22) (s := 209) (d := 2)
      [6, 10, 11, 14, 16, 17, 20, 22, 25, 29]
      (by decide +kernel) <|
      .cons n33611_slice0 <|
      .cons n33611_slice1 <|
      .cons n33611_slice2 <|
      .cons n33611_slice3 <|
      .cons n33611_slice4 <|
      .cons n33611_slice5 <|
      .cons n33611_slice6 <|
      .cons n33611_slice7 <|
      .cons n33611_slice8 <|
      .cons n33611_slice9 <|
      .single) _

end SignedDifferenceSets.CosetRows
