/-- N42591: H = ZMod 1 × ZMod 98 (c = 4), x ↦ 11x, 10 classes, 251363 nodes; split at depth 3 into
12 slices. -/
theorem n42591_not_hasSDS : ¬ HasSDS (ZMod 2 × ZMod 196) 151 30 :=
