    (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 98]) (c := 4) (k := 151)
      (lam := 30) (t := 11) (s := 109) (d := 3)
      [5, 8, 11, 12, 13, 15, 16, 17, 22, 24, 25, 31]
      (by decide +kernel) <|
      .cons n42591_slice0 <|
      .cons n42591_slice1 <|
      .cons n42591_slice2 <|
      .cons n42591_slice3 <|
      .cons n42591_slice4 <|
      .cons n42591_slice5 <|
