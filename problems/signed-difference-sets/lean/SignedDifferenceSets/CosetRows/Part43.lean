module

public import SignedDifferenceSets.CosetSearchWitt

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 43

7 open rows (N23261 to N4201 in search order), each closed by C10 for every n
(`not_hasSDS_of_cosetRow'`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n23261_slice0 : cosetSlice [147] 2 278 22 2 82 1 0 2 = true := by
  decide +kernel

theorem n23261_slice1 : cosetSlice [147] 2 278 22 2 82 1 2 4 = true := by
  decide +kernel

/-- N23261: H = ZMod 147 (c = 2), x ↦ 2x, 10 classes, 44259 nodes; split at depth 1 into 2 slices.
-/
theorem n23261_not_hasSDS : ¬ HasSDS (ZMod 294) 278 22 :=
  not_hasSDS_of_cosetRow' (ms := [294]) (ds := [147]) (c := 2) (t := 2) (s := 82)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [147]) (c := 2) (k := 278)
      (lam := 22) (t := 2) (s := 82) (d := 1)
      [2, 4]
      (by decide +kernel) <|
      .cons n23261_slice0 <|
      .cons n23261_slice1 <|
      .single) _

