module

public import SignedDifferenceSets.CosetSearch

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 07

6 open rows (N15202 to N59695 in search order), each closed by C16 for squarefree n
(`not_hasSDS_of_cosetRow`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n15202_slice0 : cosetSlice [1, 1, 9] 27 242 31 4 88 1 0 6 = true := by
  decide +kernel

theorem n15202_slice1 : cosetSlice [1, 1, 9] 27 242 31 4 88 1 6 11 = true := by
  decide +kernel

theorem n15202_slice2 : cosetSlice [1, 1, 9] 27 242 31 4 88 1 11 13 = true := by
  decide +kernel

/-- N15202: H = ZMod 1 × ZMod 1 × ZMod 9 (c = 27), x ↦ 4x, 5 classes, 40943 nodes; split at depth 1
into 3 slices. -/
theorem n15202_not_hasSDS : ¬ HasSDS (ZMod 3 × ZMod 9 × ZMod 9) 242 31 :=
  not_hasSDS_of_cosetRow (ms := [3, 9, 9]) (ds := [1, 1, 9]) (c := 27) (t := 4) (s := 88)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 1, 9]) (c := 27) (k := 242)
      (lam := 31) (t := 4) (s := 88) (d := 1)
      [6, 11, 13]
      (by decide +kernel) <|
      .cons n15202_slice0 <|
      .cons n15202_slice1 <|
      .cons n15202_slice2 <|
      .single) _

