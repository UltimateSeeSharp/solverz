/-- N42877: H = ZMod 1 × ZMod 1 × ZMod 98 (c = 4), x ↦ 11x, 10 classes, 72907 nodes; split at depth
2 into 3 slices. -/
theorem n42877_not_hasSDS : ¬ HasSDS (ZMod 2 × ZMod 2 × ZMod 98) 325 204 :=
  not_hasSDS_of_cosetRow' (ms := [2, 2, 98]) (ds := [1, 1, 98]) (c := 4) (t := 11) (s := 283)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 1, 98]) (c := 4) (k := 325)
      (lam := 204) (t := 11) (s := 283) (d := 2)
      [7, 10, 13]
      (by decide +kernel) <|
      .cons n42877_slice0 <|
      .cons n42877_slice1 <|
      .cons n42877_slice2 <|
      .single) _

