module

public import SignedDifferenceSets.CosetSearch

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 15

3 open rows (N3255 to N20650 in search order), each closed by C16 for squarefree n
(`not_hasSDS_of_cosetRow`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n3255_slice0 : cosetSlice [1, 25] 5 40 9 6 34 2 0 4 = true := by
  decide +kernel

theorem n3255_slice1 : cosetSlice [1, 25] 5 40 9 6 34 2 4 5 = true := by
  decide +kernel

theorem n3255_slice2 : cosetSlice [1, 25] 5 40 9 6 34 2 5 8 = true := by
  decide +kernel

theorem n3255_slice3 : cosetSlice [1, 25] 5 40 9 6 34 2 8 9 = true := by
  decide +kernel

theorem n3255_slice4 : cosetSlice [1, 25] 5 40 9 6 34 2 9 14 = true := by
  decide +kernel

/-- N3255: H = ZMod 1 × ZMod 25 (c = 5), x ↦ 6x, 9 classes, 67916 nodes; split at depth 2 into 5
slices. -/
theorem n3255_not_hasSDS : ¬ HasSDS (ZMod 5 × ZMod 25) 40 9 :=
  not_hasSDS_of_cosetRow (ms := [5, 25]) (ds := [1, 25]) (c := 5) (t := 6) (s := 34)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 25]) (c := 5) (k := 40)
      (lam := 9) (t := 6) (s := 34) (d := 2)
      [4, 5, 8, 9, 14]
      (by decide +kernel) <|
      .cons n3255_slice0 <|
      .cons n3255_slice1 <|
      .cons n3255_slice2 <|
      .cons n3255_slice3 <|
      .cons n3255_slice4 <|
      .single) _

theorem n31462_slice0 : cosetSlice [31] 11 196 39 2 116 1 0 4 = true := by
  decide +kernel

theorem n31462_slice1 : cosetSlice [31] 11 196 39 2 116 1 4 5 = true := by
  decide +kernel

theorem n31462_slice2 : cosetSlice [31] 11 196 39 2 116 1 5 6 = true := by
  decide +kernel

theorem n31462_slice3 : cosetSlice [31] 11 196 39 2 116 1 6 8 = true := by
  decide +kernel

theorem n31462_slice4 : cosetSlice [31] 11 196 39 2 116 1 8 10 = true := by
  decide +kernel

/-- N31462: H = ZMod 31 (c = 11), x ↦ 2x, 7 classes, 72361 nodes; split at depth 1 into 5 slices. -/
theorem n31462_not_hasSDS : ¬ HasSDS (ZMod 341) 196 39 :=
  not_hasSDS_of_cosetRow (ms := [341]) (ds := [31]) (c := 11) (t := 2) (s := 116)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [31]) (c := 11) (k := 196)
      (lam := 39) (t := 2) (s := 116) (d := 1)
      [4, 5, 6, 8, 10]
      (by decide +kernel) <|
      .cons n31462_slice0 <|
      .cons n31462_slice1 <|
      .cons n31462_slice2 <|
      .cons n31462_slice3 <|
      .cons n31462_slice4 <|
      .single) _

theorem n20650_slice0 : cosetSlice [1, 31] 9 170 7 8 46 1 0 3 = true := by
  decide +kernel

theorem n20650_slice1 : cosetSlice [1, 31] 9 170 7 8 46 1 3 4 = true := by
  decide +kernel

theorem n20650_slice2 : cosetSlice [1, 31] 9 170 7 8 46 1 4 5 = true := by
  decide +kernel

theorem n20650_slice3 : cosetSlice [1, 31] 9 170 7 8 46 1 5 6 = true := by
  decide +kernel

theorem n20650_slice4 : cosetSlice [1, 31] 9 170 7 8 46 1 6 8 = true := by
  decide +kernel

theorem n20650_slice5 : cosetSlice [1, 31] 9 170 7 8 46 1 8 10 = true := by
  decide +kernel

/-- N20650: H = ZMod 1 × ZMod 31 (c = 9), x ↦ 8x, 7 classes, 76261 nodes; split at depth 1 into 6
slices. -/
theorem n20650_not_hasSDS : ¬ HasSDS (ZMod 3 × ZMod 93) 170 7 :=
  not_hasSDS_of_cosetRow (ms := [3, 93]) (ds := [1, 31]) (c := 9) (t := 8) (s := 46)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 31]) (c := 9) (k := 170)
      (lam := 7) (t := 8) (s := 46) (d := 1)
      [3, 4, 5, 6, 8, 10]
      (by decide +kernel) <|
      .cons n20650_slice0 <|
      .cons n20650_slice1 <|
      .cons n20650_slice2 <|
      .cons n20650_slice3 <|
      .cons n20650_slice4 <|
      .cons n20650_slice5 <|
      .single) _

end SignedDifferenceSets.CosetRows
