theorem n15903_slice4 : cosetSlice [1, 1, 31] 8 244 48 2 110 1 7 8 = true := by
  decide +kernel

theorem n15903_slice5 : cosetSlice [1, 1, 31] 8 244 48 2 110 1 8 11 = true := by
  decide +kernel

/-- N15903: H = ZMod 1 × ZMod 1 × ZMod 31 (c = 8), x ↦ 2x, 7 classes, 111301 nodes; split at depth 1
into 6 slices. -/
theorem n15903_not_hasSDS : ¬ HasSDS (ZMod 2 × ZMod 2 × ZMod 62) 244 48 :=
  not_hasSDS_of_cosetRow' (ms := [2, 2, 62]) (ds := [1, 1, 31]) (c := 8) (t := 2) (s := 110)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 1, 31]) (c := 8) (k := 244)
      (lam := 48) (t := 2) (s := 110) (d := 1)
      [4, 5, 6, 7, 8, 11]
      (by decide +kernel) <|
      .cons n15903_slice0 <|
      .cons n15903_slice1 <|
      .cons n15903_slice2 <|
      .cons n15903_slice3 <|
      .cons n15903_slice4 <|
      .cons n15903_slice5 <|
      .single) _

theorem n15904_slice0 : cosetSlice [1, 31] 8 244 48 2 110 1 0 4 = true := by
  decide +kernel

theorem n15904_slice1 : cosetSlice [1, 31] 8 244 48 2 110 1 4 5 = true := by
