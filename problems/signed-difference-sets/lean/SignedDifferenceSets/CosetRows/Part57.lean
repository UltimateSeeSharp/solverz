module

public import SignedDifferenceSets.CosetSearchWitt

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 57

3 open rows (N58479 to N15904 in search order), each closed by C10 for every n
(`not_hasSDS_of_cosetRow'`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n58479_slice0 : cosetSlice [91] 5 122 1 11 24 2 0 11 = true := by
  decide +kernel

theorem n58479_slice1 : cosetSlice [91] 5 122 1 11 24 2 11 13 = true := by
  decide +kernel

theorem n58479_slice2 : cosetSlice [91] 5 122 1 11 24 2 13 17 = true := by
  decide +kernel

theorem n58479_slice3 : cosetSlice [91] 5 122 1 11 24 2 17 19 = true := by
  decide +kernel

theorem n58479_slice4 : cosetSlice [91] 5 122 1 11 24 2 19 28 = true := by
  decide +kernel

/-- N58479: H = ZMod 91 (c = 5), x ↦ 11x, 10 classes, 100261 nodes; split at depth 2 into 5 slices.
-/
theorem n58479_not_hasSDS : ¬ HasSDS (ZMod 455) 122 1 :=
  not_hasSDS_of_cosetRow' (ms := [455]) (ds := [91]) (c := 5) (t := 11) (s := 24)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [91]) (c := 5) (k := 122)
      (lam := 1) (t := 11) (s := 24) (d := 2)
      [11, 13, 17, 19, 28]
      (by decide +kernel) <|
      .cons n58479_slice0 <|
      .cons n58479_slice1 <|
      .cons n58479_slice2 <|
      .cons n58479_slice3 <|
      .cons n58479_slice4 <|
      .single) _

theorem n15903_slice0 : cosetSlice [1, 1, 31] 8 244 48 2 110 1 0 4 = true := by
  decide +kernel

theorem n15903_slice1 : cosetSlice [1, 1, 31] 8 244 48 2 110 1 4 5 = true := by
  decide +kernel

theorem n15903_slice2 : cosetSlice [1, 1, 31] 8 244 48 2 110 1 5 6 = true := by
