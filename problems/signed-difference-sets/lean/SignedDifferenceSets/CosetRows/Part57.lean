/-- N15904: H = ZMod 1 × ZMod 31 (c = 8), x ↦ 2x, 7 classes, 111301 nodes; split at depth 1 into 6
slices. -/
theorem n15904_not_hasSDS : ¬ HasSDS (ZMod 2 × ZMod 124) 244 48 :=
  not_hasSDS_of_cosetRow' (ms := [2, 124]) (ds := [1, 31]) (c := 8) (t := 2) (s := 110)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 31]) (c := 8) (k := 244)
      (lam := 48) (t := 2) (s := 110) (d := 1)
      [4, 5, 6, 7, 8, 11]
      (by decide +kernel) <|
      .cons n15904_slice0 <|
      .cons n15904_slice1 <|
      .cons n15904_slice2 <|
      .cons n15904_slice3 <|
      .cons n15904_slice4 <|
