module

public import SignedDifferenceSets.CosetSearch

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 25

1 open rows (N14690 to N14690 in search order), each closed by C16 for squarefree n
(`not_hasSDS_of_cosetRow`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n14690_slice0 : cosetSlice [1, 1, 27] 9 141 2 4 25 2 0 8 = true := by
  decide +kernel

theorem n14690_slice1 : cosetSlice [1, 1, 27] 9 141 2 4 25 2 8 10 = true := by
  decide +kernel

theorem n14690_slice2 : cosetSlice [1, 1, 27] 9 141 2 4 25 2 10 12 = true := by
  decide +kernel

theorem n14690_slice3 : cosetSlice [1, 1, 27] 9 141 2 4 25 2 12 14 = true := by
  decide +kernel

theorem n14690_slice4 : cosetSlice [1, 1, 27] 9 141 2 4 25 2 14 15 = true := by
  decide +kernel

theorem n14690_slice5 : cosetSlice [1, 1, 27] 9 141 2 4 25 2 15 18 = true := by
  decide +kernel

theorem n14690_slice6 : cosetSlice [1, 1, 27] 9 141 2 4 25 2 18 20 = true := by
  decide +kernel

theorem n14690_slice7 : cosetSlice [1, 1, 27] 9 141 2 4 25 2 20 23 = true := by
  decide +kernel

theorem n14690_slice8 : cosetSlice [1, 1, 27] 9 141 2 4 25 2 23 27 = true := by
  decide +kernel

/-- N14690: H = ZMod 1 × ZMod 1 × ZMod 27 (c = 9), x ↦ 4x, 7 classes, 187662 nodes; split at depth 2
into 9 slices. -/
theorem n14690_not_hasSDS : ¬ HasSDS (ZMod 3 × ZMod 3 × ZMod 27) 141 2 :=
  not_hasSDS_of_cosetRow (ms := [3, 3, 27]) (ds := [1, 1, 27]) (c := 9) (t := 4) (s := 25)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 1, 27]) (c := 9) (k := 141)
      (lam := 2) (t := 4) (s := 25) (d := 2)
      [8, 10, 12, 14, 15, 18, 20, 23, 27]
      (by decide +kernel) <|
      .cons n14690_slice0 <|
      .cons n14690_slice1 <|
      .cons n14690_slice2 <|
      .cons n14690_slice3 <|
      .cons n14690_slice4 <|
      .cons n14690_slice5 <|
      .cons n14690_slice6 <|
      .cons n14690_slice7 <|
      .cons n14690_slice8 <|
      .single) _

end SignedDifferenceSets.CosetRows
