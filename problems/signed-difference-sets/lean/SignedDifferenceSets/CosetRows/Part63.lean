module

public import SignedDifferenceSets.CosetSearchWitt

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 63

2 open rows (N7692 to N45793 in search order), each closed by C10 for every n
(`not_hasSDS_of_cosetRow'`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n7692_slice0 : cosetSlice [45] 4 59 10 7 43 3 0 8 = true := by
  decide +kernel

theorem n7692_slice1 : cosetSlice [45] 4 59 10 7 43 3 8 14 = true := by
  decide +kernel

theorem n7692_slice2 : cosetSlice [45] 4 59 10 7 43 3 14 18 = true := by
  decide +kernel

theorem n7692_slice3 : cosetSlice [45] 4 59 10 7 43 3 18 19 = true := by
  decide +kernel

theorem n7692_slice4 : cosetSlice [45] 4 59 10 7 43 3 19 20 = true := by
  decide +kernel

theorem n7692_slice5 : cosetSlice [45] 4 59 10 7 43 3 20 23 = true := by
  decide +kernel

theorem n7692_slice6 : cosetSlice [45] 4 59 10 7 43 3 23 30 = true := by
  decide +kernel

theorem n7692_slice7 : cosetSlice [45] 4 59 10 7 43 3 30 36 = true := by
  decide +kernel

/-- N7692: H = ZMod 45 (c = 4), x ↦ 7x, 10 classes, 140596 nodes; split at depth 3 into 8 slices. -/
theorem n7692_not_hasSDS : ¬ HasSDS (ZMod 180) 59 10 :=
  not_hasSDS_of_cosetRow' (ms := [180]) (ds := [45]) (c := 4) (t := 7) (s := 43)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [45]) (c := 4) (k := 59)
      (lam := 10) (t := 7) (s := 43) (d := 3)
      [8, 14, 18, 19, 20, 23, 30, 36]
      (by decide +kernel) <|
      .cons n7692_slice0 <|
      .cons n7692_slice1 <|
      .cons n7692_slice2 <|
      .cons n7692_slice3 <|
      .cons n7692_slice4 <|
      .cons n7692_slice5 <|
      .cons n7692_slice6 <|
      .cons n7692_slice7 <|
      .single) _

theorem n45793_slice0 : cosetSlice [1, 27] 15 132 8 4 58 2 0 5 = true := by
  decide +kernel

theorem n45793_slice1 : cosetSlice [1, 27] 15 132 8 4 58 2 5 6 = true := by
  decide +kernel

theorem n45793_slice2 : cosetSlice [1, 27] 15 132 8 4 58 2 6 10 = true := by
  decide +kernel

theorem n45793_slice3 : cosetSlice [1, 27] 15 132 8 4 58 2 10 11 = true := by
  decide +kernel

theorem n45793_slice4 : cosetSlice [1, 27] 15 132 8 4 58 2 11 12 = true := by
  decide +kernel

theorem n45793_slice5 : cosetSlice [1, 27] 15 132 8 4 58 2 12 14 = true := by
  decide +kernel

theorem n45793_slice6 : cosetSlice [1, 27] 15 132 8 4 58 2 14 16 = true := by
  decide +kernel

theorem n45793_slice7 : cosetSlice [1, 27] 15 132 8 4 58 2 16 17 = true := by
  decide +kernel

theorem n45793_slice8 : cosetSlice [1, 27] 15 132 8 4 58 2 17 21 = true := by
  decide +kernel

theorem n45793_slice9 : cosetSlice [1, 27] 15 132 8 4 58 2 21 25 = true := by
  decide +kernel

/-- N45793: H = ZMod 1 × ZMod 27 (c = 15), x ↦ 4x, 7 classes, 137974 nodes; split at depth 2 into 10
slices. -/
theorem n45793_not_hasSDS : ¬ HasSDS (ZMod 3 × ZMod 135) 132 8 :=
  not_hasSDS_of_cosetRow' (ms := [3, 135]) (ds := [1, 27]) (c := 15) (t := 4) (s := 58)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 27]) (c := 15) (k := 132)
      (lam := 8) (t := 4) (s := 58) (d := 2)
      [5, 6, 10, 11, 12, 14, 16, 17, 21, 25]
      (by decide +kernel) <|
      .cons n45793_slice0 <|
      .cons n45793_slice1 <|
      .cons n45793_slice2 <|
      .cons n45793_slice3 <|
      .cons n45793_slice4 <|
      .cons n45793_slice5 <|
      .cons n45793_slice6 <|
      .cons n45793_slice7 <|
      .cons n45793_slice8 <|
      .cons n45793_slice9 <|
      .single) _

end SignedDifferenceSets.CosetRows
