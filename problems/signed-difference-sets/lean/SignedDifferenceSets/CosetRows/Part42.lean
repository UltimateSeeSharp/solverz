/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 42

10 open rows (N32516 to N65612 in search order), each closed by C10 for every n
(`not_hasSDS_of_cosetRow'`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n32516_slice0 : cosetSlice [115] 3 240 44 4 124 1 0 4 = true := by
  decide +kernel

theorem n32516_slice1 : cosetSlice [115] 3 240 44 4 124 1 4 5 = true := by
  decide +kernel

/-- N32516: H = ZMod 115 (c = 3), x ↦ 4x, 9 classes, 29915 nodes; split at depth 1 into 2 slices. -/
theorem n32516_not_hasSDS : ¬ HasSDS (ZMod 345) 240 44 :=
  not_hasSDS_of_cosetRow' (ms := [345]) (ds := [115]) (c := 3) (t := 4) (s := 124)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [115]) (c := 3) (k := 240)
      (lam := 44) (t := 4) (s := 124) (d := 1)
      [4, 5]
      (by decide +kernel) <|
      .cons n32516_slice0 <|
      .cons n32516_slice1 <|
      .single) _

