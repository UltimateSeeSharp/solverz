module

public import SignedDifferenceSets.CosetSearchWitt

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 60

2 open rows (N7712 to N41331 in search order), each closed by C10 for every n
(`not_hasSDS_of_cosetRow'`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n7712_slice0 : cosetSlice [45] 4 87 38 7 83 3 0 9 = true := by
  decide +kernel

theorem n7712_slice1 : cosetSlice [45] 4 87 38 7 83 3 9 15 = true := by
  decide +kernel

theorem n7712_slice2 : cosetSlice [45] 4 87 38 7 83 3 15 19 = true := by
  decide +kernel

theorem n7712_slice3 : cosetSlice [45] 4 87 38 7 83 3 19 20 = true := by
  decide +kernel

theorem n7712_slice4 : cosetSlice [45] 4 87 38 7 83 3 20 21 = true := by
  decide +kernel

theorem n7712_slice5 : cosetSlice [45] 4 87 38 7 83 3 21 29 = true := by
  decide +kernel

theorem n7712_slice6 : cosetSlice [45] 4 87 38 7 83 3 29 35 = true := by
  decide +kernel

/-- N7712: H = ZMod 45 (c = 4), x ↦ 7x, 10 classes, 112974 nodes; split at depth 3 into 7 slices. -/
theorem n7712_not_hasSDS : ¬ HasSDS (ZMod 180) 87 38 :=
  not_hasSDS_of_cosetRow' (ms := [180]) (ds := [45]) (c := 4) (t := 7) (s := 83)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [45]) (c := 4) (k := 87)
      (lam := 38) (t := 7) (s := 83) (d := 3)
      [9, 15, 19, 20, 21, 29, 35]
      (by decide +kernel) <|
      .cons n7712_slice0 <|
      .cons n7712_slice1 <|
      .cons n7712_slice2 <|
      .cons n7712_slice3 <|
      .cons n7712_slice4 <|
      .cons n7712_slice5 <|
      .cons n7712_slice6 <|
      .single) _

theorem n41331_slice0 : cosetSlice [77] 5 145 1 4 23 2 0 6 = true := by
  decide +kernel

theorem n41331_slice1 : cosetSlice [77] 5 145 1 4 23 2 6 9 = true := by
  decide +kernel

theorem n41331_slice2 : cosetSlice [77] 5 145 1 4 23 2 9 10 = true := by
  decide +kernel

theorem n41331_slice3 : cosetSlice [77] 5 145 1 4 23 2 10 14 = true := by
  decide +kernel

theorem n41331_slice4 : cosetSlice [77] 5 145 1 4 23 2 14 15 = true := by
  decide +kernel

theorem n41331_slice5 : cosetSlice [77] 5 145 1 4 23 2 15 16 = true := by
  decide +kernel

theorem n41331_slice6 : cosetSlice [77] 5 145 1 4 23 2 16 21 = true := by
  decide +kernel

theorem n41331_slice7 : cosetSlice [77] 5 145 1 4 23 2 21 23 = true := by
  decide +kernel

/-- N41331: H = ZMod 77 (c = 5), x ↦ 4x, 9 classes, 122341 nodes; split at depth 2 into 8 slices. -/
theorem n41331_not_hasSDS : ¬ HasSDS (ZMod 385) 145 1 :=
  not_hasSDS_of_cosetRow' (ms := [385]) (ds := [77]) (c := 5) (t := 4) (s := 23)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [77]) (c := 5) (k := 145)
      (lam := 1) (t := 4) (s := 23) (d := 2)
      [6, 9, 10, 14, 15, 16, 21, 23]
      (by decide +kernel) <|
      .cons n41331_slice0 <|
      .cons n41331_slice1 <|
      .cons n41331_slice2 <|
      .cons n41331_slice3 <|
      .cons n41331_slice4 <|
      .cons n41331_slice5 <|
      .cons n41331_slice6 <|
      .cons n41331_slice7 <|
      .single) _

end SignedDifferenceSets.CosetRows
