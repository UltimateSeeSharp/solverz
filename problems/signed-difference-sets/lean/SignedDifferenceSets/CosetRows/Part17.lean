module

public import SignedDifferenceSets.CosetSearch

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 17

3 open rows (N31472 to N12466 in search order), each closed by C16 for squarefree n
(`not_hasSDS_of_cosetRow`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n31472_slice0 : cosetSlice [31] 11 220 57 8 140 1 0 3 = true := by
  decide +kernel

theorem n31472_slice1 : cosetSlice [31] 11 220 57 8 140 1 3 4 = true := by
  decide +kernel

theorem n31472_slice2 : cosetSlice [31] 11 220 57 8 140 1 4 5 = true := by
