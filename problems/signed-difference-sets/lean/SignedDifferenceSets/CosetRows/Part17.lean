  decide +kernel

/-- N31472: H = ZMod 31 (c = 11), x ↦ 8x, 7 classes, 77941 nodes; split at depth 1 into 6 slices. -/
theorem n31472_not_hasSDS : ¬ HasSDS (ZMod 341) 220 57 :=
  not_hasSDS_of_cosetRow (ms := [341]) (ds := [31]) (c := 11) (t := 8) (s := 140)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [31]) (c := 11) (k := 220)
      (lam := 57) (t := 8) (s := 140) (d := 1)
      [3, 4, 5, 6, 8, 10]
      (by decide +kernel) <|
      .cons n31472_slice0 <|
      .cons n31472_slice1 <|
      .cons n31472_slice2 <|
      .cons n31472_slice3 <|
      .cons n31472_slice4 <|
      .cons n31472_slice5 <|
      .single) _

