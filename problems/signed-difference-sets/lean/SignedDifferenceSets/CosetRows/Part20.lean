module

public import SignedDifferenceSets.CosetSearch

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 20

2 open rows (N55107 to N3300 in search order), each closed by C16 for squarefree n
(`not_hasSDS_of_cosetRow`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n55107_slice0 : cosetSlice [9] 49 440 109 7 220 1 0 4 = true := by
  decide +kernel

theorem n55107_slice1 : cosetSlice [9] 49 440 109 7 220 1 4 6 = true := by
  decide +kernel

theorem n55107_slice2 : cosetSlice [9] 49 440 109 7 220 1 6 8 = true := by
  decide +kernel

theorem n55107_slice3 : cosetSlice [9] 49 440 109 7 220 1 8 10 = true := by
  decide +kernel

theorem n55107_slice4 : cosetSlice [9] 49 440 109 7 220 1 10 12 = true := by
  decide +kernel

theorem n55107_slice5 : cosetSlice [9] 49 440 109 7 220 1 12 16 = true := by
  decide +kernel

/-- N55107: H = ZMod 9 (c = 49), x ↦ 7x, 5 classes, 99240 nodes; split at depth 1 into 6 slices. -/
theorem n55107_not_hasSDS : ¬ HasSDS (ZMod 441) 440 109 :=
  not_hasSDS_of_cosetRow (ms := [441]) (ds := [9]) (c := 49) (t := 7) (s := 220)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [9]) (c := 49) (k := 440)
      (lam := 109) (t := 7) (s := 220) (d := 1)
      [4, 6, 8, 10, 12, 16]
      (by decide +kernel) <|
      .cons n55107_slice0 <|
      .cons n55107_slice1 <|
      .cons n55107_slice2 <|
      .cons n55107_slice3 <|
      .cons n55107_slice4 <|
      .cons n55107_slice5 <|
      .single) _

theorem n3300_slice0 : cosetSlice [1, 25] 5 81 40 16 71 2 0 5 = true := by
  decide +kernel

theorem n3300_slice1 : cosetSlice [1, 25] 5 81 40 16 71 2 5 6 = true := by
  decide +kernel

theorem n3300_slice2 : cosetSlice [1, 25] 5 81 40 16 71 2 6 9 = true := by
  decide +kernel

theorem n3300_slice3 : cosetSlice [1, 25] 5 81 40 16 71 2 9 10 = true := by
  decide +kernel

theorem n3300_slice4 : cosetSlice [1, 25] 5 81 40 16 71 2 10 11 = true := by
  decide +kernel

theorem n3300_slice5 : cosetSlice [1, 25] 5 81 40 16 71 2 11 14 = true := by
  decide +kernel

theorem n3300_slice6 : cosetSlice [1, 25] 5 81 40 16 71 2 14 15 = true := by
  decide +kernel

theorem n3300_slice7 : cosetSlice [1, 25] 5 81 40 16 71 2 15 19 = true := by
  decide +kernel

/-- N3300: H = ZMod 1 × ZMod 25 (c = 5), x ↦ 16x, 9 classes, 119193 nodes; split at depth 2 into 8
slices. -/
theorem n3300_not_hasSDS : ¬ HasSDS (ZMod 5 × ZMod 25) 81 40 :=
  not_hasSDS_of_cosetRow (ms := [5, 25]) (ds := [1, 25]) (c := 5) (t := 16) (s := 71)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 25]) (c := 5) (k := 81)
      (lam := 40) (t := 16) (s := 71) (d := 2)
      [5, 6, 9, 10, 11, 14, 15, 19]
      (by decide +kernel) <|
      .cons n3300_slice0 <|
      .cons n3300_slice1 <|
      .cons n3300_slice2 <|
      .cons n3300_slice3 <|
      .cons n3300_slice4 <|
      .cons n3300_slice5 <|
      .cons n3300_slice6 <|
      .cons n3300_slice7 <|
      .single) _

end SignedDifferenceSets.CosetRows
