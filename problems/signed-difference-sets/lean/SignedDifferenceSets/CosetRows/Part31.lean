/-- N33341: H = ZMod 27 (c = 13), x ↦ 4x, 7 classes, 193058 nodes; split at depth 2 into 12 slices.
-/
theorem n33341_not_hasSDS : ¬ HasSDS (ZMod 351) 141 2 :=
  not_hasSDS_of_cosetRow (ms := [351]) (ds := [27]) (c := 13) (t := 4) (s := 29)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [27]) (c := 13) (k := 141)
      (lam := 2) (t := 4) (s := 29) (d := 2)
      [5, 7, 8, 11, 12, 13, 15, 16, 17, 18, 22, 27]
      (by decide +kernel) <|
      .cons n33341_slice0 <|
      .cons n33341_slice1 <|
      .cons n33341_slice2 <|
      .cons n33341_slice3 <|
      .cons n33341_slice4 <|
      .cons n33341_slice5 <|
      .cons n33341_slice6 <|
      .cons n33341_slice7 <|
      .cons n33341_slice8 <|
      .cons n33341_slice9 <|
      .cons n33341_slice10 <|
      .cons n33341_slice11 <|
      .single) _

end SignedDifferenceSets.CosetRows
