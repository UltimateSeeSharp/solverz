/-- N54346: H = ZMod 44 (c = 10), x ↦ 3x, 9 classes, 75748 nodes; split at depth 2 into 4 slices. -/
theorem n54346_not_hasSDS : ¬ HasSDS (ZMod 440) 377 296 :=
  not_hasSDS_of_cosetRow' (ms := [440]) (ds := [44]) (c := 10) (t := 3) (s := 361)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [44]) (c := 10) (k := 377)
      (lam := 296) (t := 3) (s := 361) (d := 2)
      [8, 10, 14, 19]
      (by decide +kernel) <|
      .cons n54346_slice0 <|
      .cons n54346_slice1 <|
      .cons n54346_slice2 <|
      .cons n54346_slice3 <|
      .single) _

