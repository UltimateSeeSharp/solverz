module

public import SignedDifferenceSets.CosetSearchWitt

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 75

1 open rows (N57443 to N57443 in search order), each closed by C10 for every n
(`not_hasSDS_of_cosetRow'`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n57443_slice0 : cosetSlice [1, 75] 6 258 2 2 34 2 0 6 = true := by
  decide +kernel

theorem n57443_slice1 : cosetSlice [1, 75] 6 258 2 2 34 2 6 8 = true := by
  decide +kernel

theorem n57443_slice2 : cosetSlice [1, 75] 6 258 2 2 34 2 8 11 = true := by
  decide +kernel

theorem n57443_slice3 : cosetSlice [1, 75] 6 258 2 2 34 2 11 12 = true := by
  decide +kernel

theorem n57443_slice4 : cosetSlice [1, 75] 6 258 2 2 34 2 12 13 = true := by
  decide +kernel

theorem n57443_slice5 : cosetSlice [1, 75] 6 258 2 2 34 2 13 16 = true := by
  decide +kernel

theorem n57443_slice6 : cosetSlice [1, 75] 6 258 2 2 34 2 16 17 = true := by
  decide +kernel

theorem n57443_slice7 : cosetSlice [1, 75] 6 258 2 2 34 2 17 18 = true := by
  decide +kernel

theorem n57443_slice8 : cosetSlice [1, 75] 6 258 2 2 34 2 18 19 = true := by
