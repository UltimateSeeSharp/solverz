/-- N57443: H = ZMod 1 × ZMod 75 (c = 6), x ↦ 2x, 8 classes, 228602 nodes; split at depth 2 into 12
slices. -/
theorem n57443_not_hasSDS : ¬ HasSDS (ZMod 3 × ZMod 150) 258 2 :=
  not_hasSDS_of_cosetRow' (ms := [3, 150]) (ds := [1, 75]) (c := 6) (t := 2) (s := 34)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 75]) (c := 6) (k := 258)
      (lam := 2) (t := 2) (s := 34) (d := 2)
      [6, 8, 11, 12, 13, 16, 17, 18, 19, 23, 28, 30]
      (by decide +kernel) <|
      .cons n57443_slice0 <|
      .cons n57443_slice1 <|
      .cons n57443_slice2 <|
      .cons n57443_slice3 <|
      .cons n57443_slice4 <|
      .cons n57443_slice5 <|
      .cons n57443_slice6 <|
      .cons n57443_slice7 <|
      .cons n57443_slice8 <|
      .cons n57443_slice9 <|
      .cons n57443_slice10 <|
      .cons n57443_slice11 <|
      .single) _

end SignedDifferenceSets.CosetRows
