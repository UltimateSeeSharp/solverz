module

public import SignedDifferenceSets.CosetSearchWitt

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 66

1 open rows (N57667 to N57667 in search order), each closed by C10 for every n
(`not_hasSDS_of_cosetRow'`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n57667_slice0 : cosetSlice [1, 75] 6 421 252 13 337 3 0 7 = true := by
  decide +kernel

theorem n57667_slice1 : cosetSlice [1, 75] 6 421 252 13 337 3 7 10 = true := by
  decide +kernel

theorem n57667_slice2 : cosetSlice [1, 75] 6 421 252 13 337 3 10 15 = true := by
  decide +kernel

theorem n57667_slice3 : cosetSlice [1, 75] 6 421 252 13 337 3 15 18 = true := by
  decide +kernel

theorem n57667_slice4 : cosetSlice [1, 75] 6 421 252 13 337 3 18 21 = true := by
  decide +kernel

theorem n57667_slice5 : cosetSlice [1, 75] 6 421 252 13 337 3 21 23 = true := by
  decide +kernel

theorem n57667_slice6 : cosetSlice [1, 75] 6 421 252 13 337 3 23 28 = true := by
  decide +kernel

theorem n57667_slice7 : cosetSlice [1, 75] 6 421 252 13 337 3 28 31 = true := by
  decide +kernel

/-- N57667: H = ZMod 1 × ZMod 75 (c = 6), x ↦ 13x, 9 classes, 184398 nodes; split at depth 3 into 8
slices. -/
theorem n57667_not_hasSDS : ¬ HasSDS (ZMod 3 × ZMod 150) 421 252 :=
  not_hasSDS_of_cosetRow' (ms := [3, 150]) (ds := [1, 75]) (c := 6) (t := 13) (s := 337)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 75]) (c := 6) (k := 421)
      (lam := 252) (t := 13) (s := 337) (d := 3)
      [7, 10, 15, 18, 21, 23, 28, 31]
      (by decide +kernel) <|
      .cons n57667_slice0 <|
      .cons n57667_slice1 <|
      .cons n57667_slice2 <|
      .cons n57667_slice3 <|
      .cons n57667_slice4 <|
      .cons n57667_slice5 <|
      .cons n57667_slice6 <|
      .cons n57667_slice7 <|
      .single) _

end SignedDifferenceSets.CosetRows
