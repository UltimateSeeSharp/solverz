/-- N33410: H = ZMod 27 (c = 13), x ↦ 4x, 7 classes, 187713 nodes; split at depth 2 into 9 slices.
-/
theorem n33410_not_hasSDS : ¬ HasSDS (ZMod 351) 189 50 :=
  not_hasSDS_of_cosetRow (ms := [351]) (ds := [27]) (c := 13) (t := 4) (s := 133)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [27]) (c := 13) (k := 189)
      (lam := 50) (t := 4) (s := 133) (d := 2)
      [8, 10, 12, 14, 15, 18, 20, 23, 27]
      (by decide +kernel) <|
      .cons n33410_slice0 <|
      .cons n33410_slice1 <|
      .cons n33410_slice2 <|
      .cons n33410_slice3 <|
      .cons n33410_slice4 <|
      .cons n33410_slice5 <|
      .cons n33410_slice6 <|
      .cons n33410_slice7 <|
      .cons n33410_slice8 <|
      .single) _

end SignedDifferenceSets.CosetRows
