module

public import SignedDifferenceSets.CosetSearch

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 12

4 open rows (N20654 to N20688 in search order), each closed by C16 for squarefree n
(`not_hasSDS_of_cosetRow`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n20654_slice0 : cosetSlice [1, 31] 9 174 17 2 70 1 0 3 = true := by
  decide +kernel

theorem n20654_slice1 : cosetSlice [1, 31] 9 174 17 2 70 1 3 4 = true := by
  decide +kernel

theorem n20654_slice2 : cosetSlice [1, 31] 9 174 17 2 70 1 4 5 = true := by
  decide +kernel

theorem n20654_slice3 : cosetSlice [1, 31] 9 174 17 2 70 1 5 7 = true := by
  decide +kernel

theorem n20654_slice4 : cosetSlice [1, 31] 9 174 17 2 70 1 7 10 = true := by
  decide +kernel

/-- N20654: H = ZMod 1 × ZMod 31 (c = 9), x ↦ 2x, 7 classes, 65839 nodes; split at depth 1 into 5
slices. -/
theorem n20654_not_hasSDS : ¬ HasSDS (ZMod 3 × ZMod 93) 174 17 :=
  not_hasSDS_of_cosetRow (ms := [3, 93]) (ds := [1, 31]) (c := 9) (t := 2) (s := 70)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 31]) (c := 9) (k := 174)
      (lam := 17) (t := 2) (s := 70) (d := 1)
      [3, 4, 5, 7, 10]
      (by decide +kernel) <|
      .cons n20654_slice0 <|
      .cons n20654_slice1 <|
      .cons n20654_slice2 <|
      .cons n20654_slice3 <|
      .cons n20654_slice4 <|
      .single) _

