module

public import SignedDifferenceSets.CosetSearch

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 39

1 open rows (N23707 to N23707 in search order), each closed by C16 for squarefree n
(`not_hasSDS_of_cosetRow`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n23707_slice0 : cosetSlice [27] 11 169 12 22 61 2 0 5 = true := by
  decide +kernel

theorem n23707_slice1 : cosetSlice [27] 11 169 12 22 61 2 5 7 = true := by
  decide +kernel

theorem n23707_slice2 : cosetSlice [27] 11 169 12 22 61 2 7 8 = true := by
  decide +kernel

theorem n23707_slice3 : cosetSlice [27] 11 169 12 22 61 2 8 11 = true := by
  decide +kernel

theorem n23707_slice4 : cosetSlice [27] 11 169 12 22 61 2 11 12 = true := by
  decide +kernel

theorem n23707_slice5 : cosetSlice [27] 11 169 12 22 61 2 12 13 = true := by
  decide +kernel

theorem n23707_slice6 : cosetSlice [27] 11 169 12 22 61 2 13 14 = true := by
  decide +kernel

theorem n23707_slice7 : cosetSlice [27] 11 169 12 22 61 2 14 17 = true := by
  decide +kernel

theorem n23707_slice8 : cosetSlice [27] 11 169 12 22 61 2 17 18 = true := by
  decide +kernel

theorem n23707_slice9 : cosetSlice [27] 11 169 12 22 61 2 18 19 = true := by
