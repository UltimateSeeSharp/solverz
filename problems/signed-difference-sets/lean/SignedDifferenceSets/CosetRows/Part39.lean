theorem n23707_slice13 : cosetSlice [27] 11 169 12 22 61 2 28 29 = true := by
  decide +kernel

/-- N23707: H = ZMod 27 (c = 11), x ↦ 22x, 7 classes, 271108 nodes; split at depth 2 into 14 slices.
-/
theorem n23707_not_hasSDS : ¬ HasSDS (ZMod 297) 169 12 :=
  not_hasSDS_of_cosetRow (ms := [297]) (ds := [27]) (c := 11) (t := 22) (s := 61)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [27]) (c := 11) (k := 169)
      (lam := 12) (t := 22) (s := 61) (d := 2)
      [5, 7, 8, 11, 12, 13, 14, 17, 18, 19, 22, 24, 28, 29]
      (by decide +kernel) <|
      .cons n23707_slice0 <|
      .cons n23707_slice1 <|
      .cons n23707_slice2 <|
      .cons n23707_slice3 <|
      .cons n23707_slice4 <|
      .cons n23707_slice5 <|
      .cons n23707_slice6 <|
      .cons n23707_slice7 <|
      .cons n23707_slice8 <|
      .cons n23707_slice9 <|
      .cons n23707_slice10 <|
      .cons n23707_slice11 <|
      .cons n23707_slice12 <|
      .cons n23707_slice13 <|
      .single) _

end SignedDifferenceSets.CosetRows
