  decide +kernel

/-- N29061: H = ZMod 1 × ZMod 65 (c = 5), x ↦ 17x, 8 classes, 170990 nodes; split at depth 2 into 7
slices. -/
theorem n29061_not_hasSDS : ¬ HasSDS (ZMod 5 × ZMod 65) 324 35 :=
  not_hasSDS_of_cosetRow' (ms := [5, 65]) (ds := [1, 65]) (c := 5) (t := 17) (s := 108)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 65]) (c := 5) (k := 324)
      (lam := 35) (t := 17) (s := 108) (d := 2)
      [14, 21, 27, 31, 37, 44, 54]
      (by decide +kernel) <|
      .cons n29061_slice0 <|
      .cons n29061_slice1 <|
      .cons n29061_slice2 <|
      .cons n29061_slice3 <|
      .cons n29061_slice4 <|
      .cons n29061_slice5 <|
      .cons n29061_slice6 <|
      .single) _

