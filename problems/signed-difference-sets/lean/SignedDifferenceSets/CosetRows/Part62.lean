(`not_hasSDS_of_cosetRow'`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n29061_slice0 : cosetSlice [1, 65] 5 324 35 17 108 2 0 14 = true := by
  decide +kernel

theorem n29061_slice1 : cosetSlice [1, 65] 5 324 35 17 108 2 14 21 = true := by
  decide +kernel

