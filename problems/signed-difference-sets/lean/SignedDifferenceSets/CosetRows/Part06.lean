module

public import SignedDifferenceSets.CosetSearch

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 06

7 open rows (N14508 to N15201 in search order), each closed by C16 for squarefree n
(`not_hasSDS_of_cosetRow`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n14508_slice0 : cosetSlice [1, 1, 27] 9 93 14 25 59 1 0 3 = true := by
  decide +kernel

theorem n14508_slice1 : cosetSlice [1, 1, 27] 9 93 14 25 59 1 3 5 = true := by
  decide +kernel

/-- N14508: H = ZMod 1 × ZMod 1 × ZMod 27 (c = 9), x ↦ 25x, 7 classes, 36886 nodes; split at depth 1
into 2 slices. -/
theorem n14508_not_hasSDS : ¬ HasSDS (ZMod 3 × ZMod 3 × ZMod 27) 93 14 :=
  not_hasSDS_of_cosetRow (ms := [3, 3, 27]) (ds := [1, 1, 27]) (c := 9) (t := 25) (s := 59)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 1, 27]) (c := 9) (k := 93)
      (lam := 14) (t := 25) (s := 59) (d := 1)
      [3, 5]
      (by decide +kernel) <|
      .cons n14508_slice0 <|
      .cons n14508_slice1 <|
      .single) _

