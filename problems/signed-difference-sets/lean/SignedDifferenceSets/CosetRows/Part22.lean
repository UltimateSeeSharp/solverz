module

public import SignedDifferenceSets.CosetSearch

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 22

2 open rows (N15064 to N33575 in search order), each closed by C16 for squarefree n
(`not_hasSDS_of_cosetRow`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n15064_slice0 : cosetSlice [1, 27] 9 221 70 16 131 2 0 10 = true := by
  decide +kernel

theorem n15064_slice1 : cosetSlice [1, 27] 9 221 70 16 131 2 10 15 = true := by
  decide +kernel

theorem n15064_slice2 : cosetSlice [1, 27] 9 221 70 16 131 2 15 18 = true := by
  decide +kernel

theorem n15064_slice3 : cosetSlice [1, 27] 9 221 70 16 131 2 18 22 = true := by
  decide +kernel

theorem n15064_slice4 : cosetSlice [1, 27] 9 221 70 16 131 2 22 24 = true := by
  decide +kernel

theorem n15064_slice5 : cosetSlice [1, 27] 9 221 70 16 131 2 24 31 = true := by
  decide +kernel

/-- N15064: H = ZMod 1 × ZMod 27 (c = 9), x ↦ 16x, 7 classes, 144192 nodes; split at depth 2 into 6
slices. -/
theorem n15064_not_hasSDS : ¬ HasSDS (ZMod 9 × ZMod 27) 221 70 :=
  not_hasSDS_of_cosetRow (ms := [9, 27]) (ds := [1, 27]) (c := 9) (t := 16) (s := 131)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 27]) (c := 9) (k := 221)
      (lam := 70) (t := 16) (s := 131) (d := 2)
      [10, 15, 18, 22, 24, 31]
      (by decide +kernel) <|
      .cons n15064_slice0 <|
      .cons n15064_slice1 <|
      .cons n15064_slice2 <|
      .cons n15064_slice3 <|
      .cons n15064_slice4 <|
      .cons n15064_slice5 <|
      .single) _

theorem n33575_slice0 : cosetSlice [27] 13 274 135 4 218 2 0 7 = true := by
  decide +kernel

theorem n33575_slice1 : cosetSlice [27] 13 274 135 4 218 2 7 11 = true := by
  decide +kernel

theorem n33575_slice2 : cosetSlice [27] 13 274 135 4 218 2 11 13 = true := by
  decide +kernel

theorem n33575_slice3 : cosetSlice [27] 13 274 135 4 218 2 13 16 = true := by
  decide +kernel

theorem n33575_slice4 : cosetSlice [27] 13 274 135 4 218 2 16 18 = true := by
  decide +kernel

theorem n33575_slice5 : cosetSlice [27] 13 274 135 4 218 2 18 23 = true := by
  decide +kernel

theorem n33575_slice6 : cosetSlice [27] 13 274 135 4 218 2 23 27 = true := by
  decide +kernel

/-- N33575: H = ZMod 27 (c = 13), x ↦ 4x, 7 classes, 140360 nodes; split at depth 2 into 7 slices.
-/
theorem n33575_not_hasSDS : ¬ HasSDS (ZMod 351) 274 135 :=
  not_hasSDS_of_cosetRow (ms := [351]) (ds := [27]) (c := 13) (t := 4) (s := 218)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [27]) (c := 13) (k := 274)
      (lam := 135) (t := 4) (s := 218) (d := 2)
      [7, 11, 13, 16, 18, 23, 27]
      (by decide +kernel) <|
      .cons n33575_slice0 <|
      .cons n33575_slice1 <|
      .cons n33575_slice2 <|
      .cons n33575_slice3 <|
      .cons n33575_slice4 <|
      .cons n33575_slice5 <|
      .cons n33575_slice6 <|
      .single) _

end SignedDifferenceSets.CosetRows
