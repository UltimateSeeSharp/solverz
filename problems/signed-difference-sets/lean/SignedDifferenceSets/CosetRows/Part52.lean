theorem n9193_slice4 : cosetSlice [65] 3 105 24 3 69 2 13 17 = true := by
  decide +kernel

/-- N9193: H = ZMod 65 (c = 3), x ↦ 3x, 10 classes, 94303 nodes; split at depth 2 into 5 slices. -/
theorem n9193_not_hasSDS : ¬ HasSDS (ZMod 195) 105 24 :=
  not_hasSDS_of_cosetRow' (ms := [195]) (ds := [65]) (c := 3) (t := 3) (s := 69)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [65]) (c := 3) (k := 105)
      (lam := 24) (t := 3) (s := 69) (d := 2)
      [7, 8, 9, 13, 17]
      (by decide +kernel) <|
      .cons n9193_slice0 <|
      .cons n9193_slice1 <|
      .cons n9193_slice2 <|
      .cons n9193_slice3 <|
      .cons n9193_slice4 <|
      .single) _

theorem n63757_slice0 : cosetSlice [1, 119] 4 304 48 2 152 2 0 9 = true := by
  decide +kernel

theorem n63757_slice1 : cosetSlice [1, 119] 4 304 48 2 152 2 9 12 = true := by
  decide +kernel

theorem n63757_slice2 : cosetSlice [1, 119] 4 304 48 2 152 2 12 17 = true := by
  decide +kernel

theorem n63757_slice3 : cosetSlice [1, 119] 4 304 48 2 152 2 17 22 = true := by
  decide +kernel

theorem n63757_slice4 : cosetSlice [1, 119] 4 304 48 2 152 2 22 26 = true := by
  decide +kernel

/-- N63757: H = ZMod 1 × ZMod 119 (c = 4), x ↦ 2x, 9 classes, 107083 nodes; split at depth 2 into 5
slices. -/
theorem n63757_not_hasSDS : ¬ HasSDS (ZMod 2 × ZMod 238) 304 48 :=
  not_hasSDS_of_cosetRow' (ms := [2, 238]) (ds := [1, 119]) (c := 4) (t := 2) (s := 152)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 119]) (c := 4) (k := 304)
      (lam := 48) (t := 2) (s := 152) (d := 2)
      [9, 12, 17, 22, 26]
      (by decide +kernel) <|
      .cons n63757_slice0 <|
      .cons n63757_slice1 <|
      .cons n63757_slice2 <|
      .cons n63757_slice3 <|
      .cons n63757_slice4 <|
      .single) _

end SignedDifferenceSets.CosetRows
