module

public import SignedDifferenceSets.CosetSearchWitt

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 52

3 open rows (N44123 to N63757 in search order), each closed by C10 for every n
(`not_hasSDS_of_cosetRow'`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n44123_slice0 : cosetSlice [57] 7 264 164 4 256 2 0 10 = true := by
  decide +kernel

theorem n44123_slice1 : cosetSlice [57] 7 264 164 4 256 2 10 14 = true := by
  decide +kernel

theorem n44123_slice2 : cosetSlice [57] 7 264 164 4 256 2 14 17 = true := by
  decide +kernel

theorem n44123_slice3 : cosetSlice [57] 7 264 164 4 256 2 17 22 = true := by
  decide +kernel

theorem n44123_slice4 : cosetSlice [57] 7 264 164 4 256 2 22 28 = true := by
  decide +kernel

/-- N44123: H = ZMod 57 (c = 7), x ↦ 4x, 9 classes, 91116 nodes; split at depth 2 into 5 slices. -/
theorem n44123_not_hasSDS : ¬ HasSDS (ZMod 399) 264 164 :=
  not_hasSDS_of_cosetRow' (ms := [399]) (ds := [57]) (c := 7) (t := 4) (s := 256)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [57]) (c := 7) (k := 264)
      (lam := 164) (t := 4) (s := 256) (d := 2)
      [10, 14, 17, 22, 28]
      (by decide +kernel) <|
      .cons n44123_slice0 <|
      .cons n44123_slice1 <|
      .cons n44123_slice2 <|
      .cons n44123_slice3 <|
      .cons n44123_slice4 <|
      .single) _

theorem n9193_slice0 : cosetSlice [65] 3 105 24 3 69 2 0 7 = true := by
  decide +kernel

theorem n9193_slice1 : cosetSlice [65] 3 105 24 3 69 2 7 8 = true := by
