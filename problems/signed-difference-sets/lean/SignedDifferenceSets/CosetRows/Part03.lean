theorem n14741_slice0 : cosetSlice [1, 81] 3 157 54 22 115 1 0 2 = true := by
  decide +kernel

theorem n14741_slice1 : cosetSlice [1, 81] 3 157 54 22 115 1 2 4 = true := by
  decide +kernel

/-- N14741: H = ZMod 1 × ZMod 81 (c = 3), x ↦ 22x, 9 classes, 28424 nodes; split at depth 1 into 2
slices. -/
theorem n14741_not_hasSDS : ¬ HasSDS (ZMod 3 × ZMod 81) 157 54 :=
  not_hasSDS_of_cosetRow (ms := [3, 81]) (ds := [1, 81]) (c := 3) (t := 22) (s := 115)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 81]) (c := 3) (k := 157)
      (lam := 54) (t := 22) (s := 115) (d := 1)
      [2, 4]
      (by decide +kernel) <|
      .cons n14741_slice0 <|
      .cons n14741_slice1 <|
      .single) _

