module

public import SignedDifferenceSets.CosetSearch

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 21

2 open rows (N15061 to N15063 in search order), each closed by C16 for squarefree n
(`not_hasSDS_of_cosetRow`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n15061_slice0 : cosetSlice [1, 1, 27] 9 221 70 16 131 2 0 10 = true := by
  decide +kernel

theorem n15061_slice1 : cosetSlice [1, 1, 27] 9 221 70 16 131 2 10 15 = true := by
  decide +kernel

theorem n15061_slice2 : cosetSlice [1, 1, 27] 9 221 70 16 131 2 15 18 = true := by
  decide +kernel

theorem n15061_slice3 : cosetSlice [1, 1, 27] 9 221 70 16 131 2 18 22 = true := by
  decide +kernel

theorem n15061_slice4 : cosetSlice [1, 1, 27] 9 221 70 16 131 2 22 24 = true := by
  decide +kernel

theorem n15061_slice5 : cosetSlice [1, 1, 27] 9 221 70 16 131 2 24 31 = true := by
  decide +kernel

/-- N15061: H = ZMod 1 × ZMod 1 × ZMod 27 (c = 9), x ↦ 16x, 7 classes, 144192 nodes; split at depth
2 into 6 slices. -/
theorem n15061_not_hasSDS : ¬ HasSDS (ZMod 3 × ZMod 3 × ZMod 27) 221 70 :=
  not_hasSDS_of_cosetRow (ms := [3, 3, 27]) (ds := [1, 1, 27]) (c := 9) (t := 16) (s := 131)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 1, 27]) (c := 9) (k := 221)
      (lam := 70) (t := 16) (s := 131) (d := 2)
      [10, 15, 18, 22, 24, 31]
      (by decide +kernel) <|
      .cons n15061_slice0 <|
      .cons n15061_slice1 <|
      .cons n15061_slice2 <|
      .cons n15061_slice3 <|
      .cons n15061_slice4 <|
      .cons n15061_slice5 <|
      .single) _

theorem n15063_slice0 : cosetSlice [1, 27] 9 221 70 16 131 2 0 10 = true := by
  decide +kernel

theorem n15063_slice1 : cosetSlice [1, 27] 9 221 70 16 131 2 10 15 = true := by
  decide +kernel

theorem n15063_slice2 : cosetSlice [1, 27] 9 221 70 16 131 2 15 18 = true := by
  decide +kernel

theorem n15063_slice3 : cosetSlice [1, 27] 9 221 70 16 131 2 18 22 = true := by
  decide +kernel

theorem n15063_slice4 : cosetSlice [1, 27] 9 221 70 16 131 2 22 24 = true := by
  decide +kernel

theorem n15063_slice5 : cosetSlice [1, 27] 9 221 70 16 131 2 24 31 = true := by
  decide +kernel

/-- N15063: H = ZMod 1 × ZMod 27 (c = 9), x ↦ 16x, 7 classes, 144192 nodes; split at depth 2 into 6
slices. -/
theorem n15063_not_hasSDS : ¬ HasSDS (ZMod 3 × ZMod 81) 221 70 :=
  not_hasSDS_of_cosetRow (ms := [3, 81]) (ds := [1, 27]) (c := 9) (t := 16) (s := 131)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 27]) (c := 9) (k := 221)
      (lam := 70) (t := 16) (s := 131) (d := 2)
      [10, 15, 18, 22, 24, 31]
      (by decide +kernel) <|
      .cons n15063_slice0 <|
      .cons n15063_slice1 <|
      .cons n15063_slice2 <|
      .cons n15063_slice3 <|
      .cons n15063_slice4 <|
      .cons n15063_slice5 <|
      .single) _

end SignedDifferenceSets.CosetRows
