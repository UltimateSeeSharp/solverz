/-- N41360: H = ZMod 77 (c = 5), x ↦ 4x, 9 classes, 91750 nodes; split at depth 2 into 4 slices. -/
theorem n41360_not_hasSDS : ¬ HasSDS (ZMod 385) 225 81 :=
