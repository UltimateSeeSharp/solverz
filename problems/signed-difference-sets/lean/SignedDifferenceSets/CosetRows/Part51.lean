module

public import SignedDifferenceSets.CosetSearchWitt

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 51

3 open rows (N58557 to N41360 in search order), each closed by C10 for every n
(`not_hasSDS_of_cosetRow'`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n58557_slice0 : cosetSlice [91] 5 298 177 11 284 2 0 10 = true := by
  decide +kernel

theorem n58557_slice1 : cosetSlice [91] 5 298 177 11 284 2 10 12 = true := by
  decide +kernel

theorem n58557_slice2 : cosetSlice [91] 5 298 177 11 284 2 12 16 = true := by
  decide +kernel

theorem n58557_slice3 : cosetSlice [91] 5 298 177 11 284 2 16 24 = true := by
  decide +kernel

/-- N58557: H = ZMod 91 (c = 5), x ↦ 11x, 10 classes, 82731 nodes; split at depth 2 into 4 slices.
-/
theorem n58557_not_hasSDS : ¬ HasSDS (ZMod 455) 298 177 :=
  not_hasSDS_of_cosetRow' (ms := [455]) (ds := [91]) (c := 5) (t := 11) (s := 284)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [91]) (c := 5) (k := 298)
      (lam := 177) (t := 11) (s := 284) (d := 2)
      [10, 12, 16, 24]
      (by decide +kernel) <|
      .cons n58557_slice0 <|
      .cons n58557_slice1 <|
      .cons n58557_slice2 <|
      .cons n58557_slice3 <|
      .single) _

