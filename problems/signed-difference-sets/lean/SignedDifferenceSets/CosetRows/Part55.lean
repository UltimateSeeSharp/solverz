/-- N69390: H = ZMod 15 (c = 33), x ↦ 13x, 6 classes, 102100 nodes; split at depth 1 into 6 slices.
-/
theorem n69390_not_hasSDS : ¬ HasSDS (ZMod 495) 465 296 :=
  not_hasSDS_of_cosetRow' (ms := [495]) (ds := [15]) (c := 33) (t := 13) (s := 383)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [15]) (c := 33) (k := 465)
      (lam := 296) (t := 13) (s := 383) (d := 1)
      [3, 4, 5, 6, 7, 10]
      (by decide +kernel) <|
      .cons n69390_slice0 <|
      .cons n69390_slice1 <|
      .cons n69390_slice2 <|
      .cons n69390_slice3 <|
      .cons n69390_slice4 <|
      .cons n69390_slice5 <|
      .single) _

