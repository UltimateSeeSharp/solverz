module

public import SignedDifferenceSets.CosetSearchWitt

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 44

7 open rows (N7765 to N36418 in search order), each closed by C10 for every n
(`not_hasSDS_of_cosetRow'`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n7765_slice0 : cosetSlice [1, 45] 4 147 98 7 133 2 0 4 = true := by
  decide +kernel

theorem n7765_slice1 : cosetSlice [1, 45] 4 147 98 7 133 2 4 6 = true := by
  decide +kernel

theorem n7765_slice2 : cosetSlice [1, 45] 4 147 98 7 133 2 6 7 = true := by
  decide +kernel

/-- N7765: H = ZMod 1 × ZMod 45 (c = 4), x ↦ 7x, 10 classes, 42020 nodes; split at depth 2 into 3
slices. -/
theorem n7765_not_hasSDS : ¬ HasSDS (ZMod 2 × ZMod 90) 147 98 :=
  not_hasSDS_of_cosetRow' (ms := [2, 90]) (ds := [1, 45]) (c := 4) (t := 7) (s := 133)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 45]) (c := 4) (k := 147)
      (lam := 98) (t := 7) (s := 133) (d := 2)
      [4, 6, 7]
      (by decide +kernel) <|
      .cons n7765_slice0 <|
      .cons n7765_slice1 <|
      .cons n7765_slice2 <|
      .single) _

