module

public import SignedDifferenceSets.CosetSearchWitt

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 59

2 open rows (N4114 to N53283 in search order), each closed by C10 for every n
(`not_hasSDS_of_cosetRow'`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n4114_slice0 : cosetSlice [1, 45] 3 65 16 7 47 3 0 14 = true := by
  decide +kernel

theorem n4114_slice1 : cosetSlice [1, 45] 3 65 16 7 47 3 14 17 = true := by
  decide +kernel

theorem n4114_slice2 : cosetSlice [1, 45] 3 65 16 7 47 3 17 20 = true := by
  decide +kernel

theorem n4114_slice3 : cosetSlice [1, 45] 3 65 16 7 47 3 20 29 = true := by
  decide +kernel

theorem n4114_slice4 : cosetSlice [1, 45] 3 65 16 7 47 3 29 35 = true := by
  decide +kernel

/-- N4114: H = ZMod 1 × ZMod 45 (c = 3), x ↦ 7x, 10 classes, 102851 nodes; split at depth 3 into 5
slices. -/
theorem n4114_not_hasSDS : ¬ HasSDS (ZMod 3 × ZMod 45) 65 16 :=
  not_hasSDS_of_cosetRow' (ms := [3, 45]) (ds := [1, 45]) (c := 3) (t := 7) (s := 47)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 45]) (c := 3) (k := 65)
      (lam := 16) (t := 7) (s := 47) (d := 3)
      [14, 17, 20, 29, 35]
      (by decide +kernel) <|
      .cons n4114_slice0 <|
      .cons n4114_slice1 <|
      .cons n4114_slice2 <|
      .cons n4114_slice3 <|
      .cons n4114_slice4 <|
      .single) _

theorem n53283_slice0 : cosetSlice [87] 5 193 24 13 103 2 0 7 = true := by
  decide +kernel

theorem n53283_slice1 : cosetSlice [87] 5 193 24 13 103 2 7 12 = true := by
  decide +kernel

theorem n53283_slice2 : cosetSlice [87] 5 193 24 13 103 2 12 14 = true := by
  decide +kernel

theorem n53283_slice3 : cosetSlice [87] 5 193 24 13 103 2 14 18 = true := by
  decide +kernel

theorem n53283_slice4 : cosetSlice [87] 5 193 24 13 103 2 18 23 = true := by
  decide +kernel

theorem n53283_slice5 : cosetSlice [87] 5 193 24 13 103 2 23 30 = true := by
  decide +kernel

/-- N53283: H = ZMod 87 (c = 5), x ↦ 13x, 9 classes, 137116 nodes; split at depth 2 into 6 slices.
-/
theorem n53283_not_hasSDS : ¬ HasSDS (ZMod 435) 193 24 :=
  not_hasSDS_of_cosetRow' (ms := [435]) (ds := [87]) (c := 5) (t := 13) (s := 103)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [87]) (c := 5) (k := 193)
      (lam := 24) (t := 13) (s := 103) (d := 2)
      [7, 12, 14, 18, 23, 30]
      (by decide +kernel) <|
      .cons n53283_slice0 <|
      .cons n53283_slice1 <|
      .cons n53283_slice2 <|
      .cons n53283_slice3 <|
      .cons n53283_slice4 <|
      .cons n53283_slice5 <|
      .single) _

end SignedDifferenceSets.CosetRows
