module

public import SignedDifferenceSets.CosetSearchCongr

/-!
# Rows killed by C25's coset-sum multipliers with C5's congruence (I18), part 97

9 open rows (N31578 to N58654 in search order), each closed by C25 and C5
(`not_hasSDS_of_cosetRowCongr`: self-conjugate primes of n impose nothing on t, and the coset sums
agree mod q) and the filtered coset search on a quotient of order prime to n (generated by
`solver/a7selfconj.py write-congr`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

/-- N31578: H = ZMod 3 × ZMod 57 (c = 2), x ↦ 5x, self-conjugate [2], coset sums agree mod 2 (C5),
15 classes, 554 nodes. -/
theorem n31578_not_hasSDS : ¬ HasSDS (ZMod 3 × ZMod 114) 102 2 :=
  not_hasSDS_of_cosetRowCongr (ms := [3, 114]) (ds := [3, 57]) (c := 2) (t := 5) (s := 28) (q := 2)
    (by decide +kernel) (by decide +kernel) _

