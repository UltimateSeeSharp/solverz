theorem n58654_res0 : cosetSearchR [65] 7 423 99 3 213 2 0 = true :=
  cosetSearchR_of_slices (ds := [65]) (c := 7) (k := 423)
    (lam := 99) (t := 3) (s := 213) (q := 2) (res := 0) (d := 2)
    [7, 8, 9, 12, 13, 14, 19]
    (by decide +kernel) <|
    .cons n58654_res0_slice0 <|
    .cons n58654_res0_slice1 <|
    .cons n58654_res0_slice2 <|
    .cons n58654_res0_slice3 <|
    .cons n58654_res0_slice4 <|
    .cons n58654_res0_slice5 <|
    .cons n58654_res0_slice6 <|
    .single

