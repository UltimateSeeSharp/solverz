theorem n58654_res1 : cosetSearchR [65] 7 423 99 3 213 2 1 = true :=
  cosetSearchR_of_slices (ds := [65]) (c := 7) (k := 423)
    (lam := 99) (t := 3) (s := 213) (q := 2) (res := 1) (d := 2)
    [7, 10, 15]
    (by decide +kernel) <|
    .cons n58654_res1_slice0 <|
    .cons n58654_res1_slice1 <|
    .cons n58654_res1_slice2 <|
    .single

/-- N58654: H = ZMod 65 (c = 7), x ↦ 3x, self-conjugate [2], coset sums agree mod 2 (C5), 10
classes, 133605 nodes; one search per residue. -/
theorem n58654_not_hasSDS : ¬ HasSDS (ZMod 455) 423 99 :=
  not_hasSDS_of_cosetRowCongr (ms := [455]) (ds := [65]) (c := 7) (t := 3) (s := 213) (q := 2)
    (by decide +kernel) (forall_lt_two n58654_res0 n58654_res1) _

end SignedDifferenceSets.CosetRows
