module

public import SignedDifferenceSets.CosetSearchSelfConj

/-!
# Rows killed by coset sums fixed by a multiplier of C25's group (I18), part 96

1 open rows (N53285 to N53285 in search order), each closed by C25
(`not_hasSDS_of_cosetRowSelfConj`: self-conjugate primes of n impose nothing on t) and the coset
search on a quotient of order prime to n (generated by `solver/a7selfconj.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n53285_slice0 : cosetSlice [145] 3 200 4 7 44 2 0 6 = true := by
  decide +kernel

theorem n53285_slice1 : cosetSlice [145] 3 200 4 7 44 2 6 7 = true := by
  decide +kernel

theorem n53285_slice2 : cosetSlice [145] 3 200 4 7 44 2 7 10 = true := by
  decide +kernel

theorem n53285_slice3 : cosetSlice [145] 3 200 4 7 44 2 10 12 = true := by
  decide +kernel

theorem n53285_slice4 : cosetSlice [145] 3 200 4 7 44 2 12 17 = true := by
  decide +kernel

/-- N53285: H = ZMod 145 (c = 3), x ↦ 7x, self-conjugate [2], 10 classes, 100312 nodes; split at
depth 2 into 5 slices. -/
theorem n53285_not_hasSDS : ¬ HasSDS (ZMod 435) 200 4 :=
  not_hasSDS_of_cosetRowSelfConj (ms := [435]) (ds := [145]) (c := 3) (t := 7) (s := 44)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [145]) (c := 3) (k := 200)
      (lam := 4) (t := 7) (s := 44) (d := 2)
      [6, 7, 10, 12, 17]
      (by decide +kernel) <|
      .cons n53285_slice0 <|
      .cons n53285_slice1 <|
      .cons n53285_slice2 <|
      .cons n53285_slice3 <|
      .cons n53285_slice4 <|
      .single) _

end SignedDifferenceSets.CosetRows
