module

public import SignedDifferenceSets.CosetSearch

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 08

5 open rows (N20800 to N20809 in search order), each closed by C16 for squarefree n
(`not_hasSDS_of_cosetRow`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n20800_slice0 : cosetSlice [1, 31] 9 266 103 8 170 1 0 4 = true := by
  decide +kernel

theorem n20800_slice1 : cosetSlice [1, 31] 9 266 103 8 170 1 4 6 = true := by
  decide +kernel

theorem n20800_slice2 : cosetSlice [1, 31] 9 266 103 8 170 1 6 9 = true := by
  decide +kernel

/-- N20800: H = ZMod 1 × ZMod 31 (c = 9), x ↦ 8x, 7 classes, 54663 nodes; split at depth 1 into 3
slices. -/
theorem n20800_not_hasSDS : ¬ HasSDS (ZMod 3 × ZMod 93) 266 103 :=
  not_hasSDS_of_cosetRow (ms := [3, 93]) (ds := [1, 31]) (c := 9) (t := 8) (s := 170)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 31]) (c := 9) (k := 266)
      (lam := 103) (t := 8) (s := 170) (d := 1)
      [4, 6, 9]
      (by decide +kernel) <|
      .cons n20800_slice0 <|
      .cons n20800_slice1 <|
      .cons n20800_slice2 <|
      .single) _

