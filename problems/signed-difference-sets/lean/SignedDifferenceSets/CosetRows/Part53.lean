module

public import SignedDifferenceSets.CosetSearchWitt

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 53

3 open rows (N32473 to N12763 in search order), each closed by C10 for every n
(`not_hasSDS_of_cosetRow'`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n32473_slice0 : cosetSlice [69] 5 160 36 4 112 2 0 10 = true := by
  decide +kernel

theorem n32473_slice1 : cosetSlice [69] 5 160 36 4 112 2 10 13 = true := by
  decide +kernel

theorem n32473_slice2 : cosetSlice [69] 5 160 36 4 112 2 13 17 = true := by
  decide +kernel

theorem n32473_slice3 : cosetSlice [69] 5 160 36 4 112 2 17 22 = true := by
  decide +kernel

theorem n32473_slice4 : cosetSlice [69] 5 160 36 4 112 2 22 30 = true := by
  decide +kernel

/-- N32473: H = ZMod 69 (c = 5), x ↦ 4x, 9 classes, 105401 nodes; split at depth 2 into 5 slices. -/
theorem n32473_not_hasSDS : ¬ HasSDS (ZMod 345) 160 36 :=
  not_hasSDS_of_cosetRow' (ms := [345]) (ds := [69]) (c := 5) (t := 4) (s := 112)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [69]) (c := 5) (k := 160)
      (lam := 36) (t := 4) (s := 112) (d := 2)
      [10, 13, 17, 22, 30]
      (by decide +kernel) <|
      .cons n32473_slice0 <|
      .cons n32473_slice1 <|
      .cons n32473_slice2 <|
      .cons n32473_slice3 <|
      .cons n32473_slice4 <|
      .single) _

theorem n36340_slice0 : cosetSlice [91] 4 133 12 11 67 2 0 9 = true := by
  decide +kernel

theorem n36340_slice1 : cosetSlice [91] 4 133 12 11 67 2 9 14 = true := by
  decide +kernel

theorem n36340_slice2 : cosetSlice [91] 4 133 12 11 67 2 14 16 = true := by
  decide +kernel

theorem n36340_slice3 : cosetSlice [91] 4 133 12 11 67 2 16 22 = true := by
  decide +kernel

theorem n36340_slice4 : cosetSlice [91] 4 133 12 11 67 2 22 28 = true := by
  decide +kernel

/-- N36340: H = ZMod 91 (c = 4), x ↦ 11x, 10 classes, 97209 nodes; split at depth 2 into 5 slices.
-/
theorem n36340_not_hasSDS : ¬ HasSDS (ZMod 364) 133 12 :=
  not_hasSDS_of_cosetRow' (ms := [364]) (ds := [91]) (c := 4) (t := 11) (s := 67)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [91]) (c := 4) (k := 133)
      (lam := 12) (t := 11) (s := 67) (d := 2)
      [9, 14, 16, 22, 28]
      (by decide +kernel) <|
      .cons n36340_slice0 <|
      .cons n36340_slice1 <|
      .cons n36340_slice2 <|
      .cons n36340_slice3 <|
      .cons n36340_slice4 <|
      .single) _

theorem n12763_slice0 : cosetSlice [1, 15] 15 224 55 13 112 1 0 3 = true := by
  decide +kernel

theorem n12763_slice1 : cosetSlice [1, 15] 15 224 55 13 112 1 3 4 = true := by
  decide +kernel

theorem n12763_slice2 : cosetSlice [1, 15] 15 224 55 13 112 1 4 5 = true := by
  decide +kernel

theorem n12763_slice3 : cosetSlice [1, 15] 15 224 55 13 112 1 5 6 = true := by
  decide +kernel

theorem n12763_slice4 : cosetSlice [1, 15] 15 224 55 13 112 1 6 7 = true := by
  decide +kernel

theorem n12763_slice5 : cosetSlice [1, 15] 15 224 55 13 112 1 7 10 = true := by
  decide +kernel

/-- N12763: H = ZMod 1 × ZMod 15 (c = 15), x ↦ 13x, 6 classes, 102783 nodes; split at depth 1 into 6
slices. -/
theorem n12763_not_hasSDS : ¬ HasSDS (ZMod 3 × ZMod 75) 224 55 :=
  not_hasSDS_of_cosetRow' (ms := [3, 75]) (ds := [1, 15]) (c := 15) (t := 13) (s := 112)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 15]) (c := 15) (k := 224)
      (lam := 55) (t := 13) (s := 112) (d := 1)
      [3, 4, 5, 6, 7, 10]
      (by decide +kernel) <|
      .cons n12763_slice0 <|
      .cons n12763_slice1 <|
      .cons n12763_slice2 <|
      .cons n12763_slice3 <|
      .cons n12763_slice4 <|
      .cons n12763_slice5 <|
      .single) _

end SignedDifferenceSets.CosetRows
