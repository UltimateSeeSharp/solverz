    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [27]) (c := 11) (k := 201)
      (lam := 44) (t := 22) (s := 115) (d := 2)
      [6, 7, 8, 11, 12, 13, 14, 17, 18, 19, 22, 24, 28, 29]
      (by decide +kernel) <|
