/-- N23770: H = ZMod 27 (c = 11), x ↦ 22x, 7 classes, 243397 nodes; split at depth 2 into 14 slices.
-/
theorem n23770_not_hasSDS : ¬ HasSDS (ZMod 297) 201 44 :=
