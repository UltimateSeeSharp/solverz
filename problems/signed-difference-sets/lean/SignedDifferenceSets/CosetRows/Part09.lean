module

public import SignedDifferenceSets.CosetSearch

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 09

5 open rows (N14809 to N14592 in search order), each closed by C16 for squarefree n
(`not_hasSDS_of_cosetRow`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n14809_slice0 : cosetSlice [1, 1, 27] 9 170 67 22 128 1 0 2 = true := by
  decide +kernel

theorem n14809_slice1 : cosetSlice [1, 1, 27] 9 170 67 22 128 1 2 3 = true := by
  decide +kernel

theorem n14809_slice2 : cosetSlice [1, 1, 27] 9 170 67 22 128 1 3 5 = true := by
  decide +kernel

/-- N14809: H = ZMod 1 × ZMod 1 × ZMod 27 (c = 9), x ↦ 22x, 7 classes, 59948 nodes; split at depth 1
into 3 slices. -/
theorem n14809_not_hasSDS : ¬ HasSDS (ZMod 3 × ZMod 3 × ZMod 27) 170 67 :=
  not_hasSDS_of_cosetRow (ms := [3, 3, 27]) (ds := [1, 1, 27]) (c := 9) (t := 22) (s := 128)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 1, 27]) (c := 9) (k := 170)
      (lam := 67) (t := 22) (s := 128) (d := 1)
      [2, 3, 5]
      (by decide +kernel) <|
      .cons n14809_slice0 <|
      .cons n14809_slice1 <|
      .cons n14809_slice2 <|
      .single) _

