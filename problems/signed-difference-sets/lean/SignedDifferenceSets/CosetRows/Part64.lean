module

public import SignedDifferenceSets.CosetSearchWitt

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 64

2 open rows (N45795 to N7693 in search order), each closed by C10 for every n
(`not_hasSDS_of_cosetRow'`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n45795_slice0 : cosetSlice [27] 15 132 8 4 58 2 0 5 = true := by
  decide +kernel

theorem n45795_slice1 : cosetSlice [27] 15 132 8 4 58 2 5 6 = true := by
  decide +kernel

theorem n45795_slice2 : cosetSlice [27] 15 132 8 4 58 2 6 10 = true := by
  decide +kernel

theorem n45795_slice3 : cosetSlice [27] 15 132 8 4 58 2 10 11 = true := by
  decide +kernel

theorem n45795_slice4 : cosetSlice [27] 15 132 8 4 58 2 11 12 = true := by
  decide +kernel

theorem n45795_slice5 : cosetSlice [27] 15 132 8 4 58 2 12 14 = true := by
  decide +kernel

theorem n45795_slice6 : cosetSlice [27] 15 132 8 4 58 2 14 16 = true := by
  decide +kernel

theorem n45795_slice7 : cosetSlice [27] 15 132 8 4 58 2 16 17 = true := by
  decide +kernel

theorem n45795_slice8 : cosetSlice [27] 15 132 8 4 58 2 17 21 = true := by
  decide +kernel

theorem n45795_slice9 : cosetSlice [27] 15 132 8 4 58 2 21 25 = true := by
  decide +kernel

/-- N45795: H = ZMod 27 (c = 15), x ↦ 4x, 7 classes, 137974 nodes; split at depth 2 into 10 slices.
-/
theorem n45795_not_hasSDS : ¬ HasSDS (ZMod 405) 132 8 :=
  not_hasSDS_of_cosetRow' (ms := [405]) (ds := [27]) (c := 15) (t := 4) (s := 58)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [27]) (c := 15) (k := 132)
      (lam := 8) (t := 4) (s := 58) (d := 2)
      [5, 6, 10, 11, 12, 14, 16, 17, 21, 25]
      (by decide +kernel) <|
      .cons n45795_slice0 <|
      .cons n45795_slice1 <|
      .cons n45795_slice2 <|
      .cons n45795_slice3 <|
      .cons n45795_slice4 <|
      .cons n45795_slice5 <|
      .cons n45795_slice6 <|
      .cons n45795_slice7 <|
      .cons n45795_slice8 <|
      .cons n45795_slice9 <|
      .single) _

theorem n7693_slice0 : cosetSlice [1, 45] 4 61 12 7 47 3 0 9 = true := by
  decide +kernel

theorem n7693_slice1 : cosetSlice [1, 45] 4 61 12 7 47 3 9 15 = true := by
  decide +kernel

theorem n7693_slice2 : cosetSlice [1, 45] 4 61 12 7 47 3 15 16 = true := by
  decide +kernel

theorem n7693_slice3 : cosetSlice [1, 45] 4 61 12 7 47 3 16 17 = true := by
  decide +kernel

theorem n7693_slice4 : cosetSlice [1, 45] 4 61 12 7 47 3 17 18 = true := by
  decide +kernel

theorem n7693_slice5 : cosetSlice [1, 45] 4 61 12 7 47 3 18 22 = true := by
  decide +kernel

theorem n7693_slice6 : cosetSlice [1, 45] 4 61 12 7 47 3 22 30 = true := by
  decide +kernel

theorem n7693_slice7 : cosetSlice [1, 45] 4 61 12 7 47 3 30 36 = true := by
  decide +kernel

/-- N7693: H = ZMod 1 × ZMod 45 (c = 4), x ↦ 7x, 10 classes, 140644 nodes; split at depth 3 into 8
slices. -/
theorem n7693_not_hasSDS : ¬ HasSDS (ZMod 2 × ZMod 90) 61 12 :=
  not_hasSDS_of_cosetRow' (ms := [2, 90]) (ds := [1, 45]) (c := 4) (t := 7) (s := 47)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 45]) (c := 4) (k := 61)
      (lam := 12) (t := 7) (s := 47) (d := 3)
      [9, 15, 16, 17, 18, 22, 30, 36]
      (by decide +kernel) <|
      .cons n7693_slice0 <|
      .cons n7693_slice1 <|
      .cons n7693_slice2 <|
      .cons n7693_slice3 <|
      .cons n7693_slice4 <|
      .cons n7693_slice5 <|
      .cons n7693_slice6 <|
      .cons n7693_slice7 <|
      .single) _

end SignedDifferenceSets.CosetRows
