  decide +kernel

/-- N12764: H = ZMod 1 × ZMod 15 (c = 15), x ↦ 13x, 6 classes, 102783 nodes; split at depth 1 into 6
slices. -/
theorem n12764_not_hasSDS : ¬ HasSDS (ZMod 5 × ZMod 45) 224 55 :=
  not_hasSDS_of_cosetRow' (ms := [5, 45]) (ds := [1, 15]) (c := 15) (t := 13) (s := 112)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 15]) (c := 15) (k := 224)
      (lam := 55) (t := 13) (s := 112) (d := 1)
      [3, 4, 5, 6, 7, 10]
      (by decide +kernel) <|
      .cons n12764_slice0 <|
      .cons n12764_slice1 <|
      .cons n12764_slice2 <|
      .cons n12764_slice3 <|
      .cons n12764_slice4 <|
      .cons n12764_slice5 <|
      .single) _

