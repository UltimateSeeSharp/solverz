module

public import SignedDifferenceSets.CosetSearchWitt

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 80

1 open rows (N35216 to N35216 in search order), each closed by C10 for every n
(`not_hasSDS_of_cosetRow'`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n35216_slice0 : cosetSlice [1, 45] 8 55 6 7 47 4 0 23 = true := by
  decide +kernel

theorem n35216_slice1 : cosetSlice [1, 45] 8 55 6 7 47 4 23 43 = true := by
  decide +kernel

theorem n35216_slice2 : cosetSlice [1, 45] 8 55 6 7 47 4 43 55 = true := by
  decide +kernel

theorem n35216_slice3 : cosetSlice [1, 45] 8 55 6 7 47 4 55 60 = true := by
  decide +kernel

theorem n35216_slice4 : cosetSlice [1, 45] 8 55 6 7 47 4 60 65 = true := by
  decide +kernel

theorem n35216_slice5 : cosetSlice [1, 45] 8 55 6 7 47 4 65 69 = true := by
  decide +kernel

theorem n35216_slice6 : cosetSlice [1, 45] 8 55 6 7 47 4 69 83 = true := by
  decide +kernel

theorem n35216_slice7 : cosetSlice [1, 45] 8 55 6 7 47 4 83 102 = true := by
  decide +kernel

theorem n35216_slice8 : cosetSlice [1, 45] 8 55 6 7 47 4 102 121 = true := by
  decide +kernel

theorem n35216_slice9 : cosetSlice [1, 45] 8 55 6 7 47 4 121 131 = true := by
  decide +kernel

/-- N35216: H = ZMod 1 × ZMod 45 (c = 8), x ↦ 7x, 10 classes, 160349 nodes; split at depth 4 into 10
slices. -/
theorem n35216_not_hasSDS : ¬ HasSDS (ZMod 2 × ZMod 180) 55 6 :=
  not_hasSDS_of_cosetRow' (ms := [2, 180]) (ds := [1, 45]) (c := 8) (t := 7) (s := 47)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 45]) (c := 8) (k := 55)
      (lam := 6) (t := 7) (s := 47) (d := 4)
      [23, 43, 55, 60, 65, 69, 83, 102, 121, 131]
      (by decide +kernel) <|
      .cons n35216_slice0 <|
      .cons n35216_slice1 <|
      .cons n35216_slice2 <|
      .cons n35216_slice3 <|
      .cons n35216_slice4 <|
      .cons n35216_slice5 <|
      .cons n35216_slice6 <|
      .cons n35216_slice7 <|
      .cons n35216_slice8 <|
      .cons n35216_slice9 <|
      .single) _

end SignedDifferenceSets.CosetRows
