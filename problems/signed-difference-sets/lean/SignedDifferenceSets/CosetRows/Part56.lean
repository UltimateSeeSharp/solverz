module

public import SignedDifferenceSets.CosetSearchWitt

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 56

3 open rows (N7305 to N58509 in search order), each closed by C10 for every n
(`not_hasSDS_of_cosetRow'`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n7305_slice0 : cosetSlice [25] 7 151 107 16 137 2 0 7 = true := by
  decide +kernel

theorem n7305_slice1 : cosetSlice [25] 7 151 107 16 137 2 7 10 = true := by
  decide +kernel

theorem n7305_slice2 : cosetSlice [25] 7 151 107 16 137 2 10 12 = true := by
  decide +kernel

theorem n7305_slice3 : cosetSlice [25] 7 151 107 16 137 2 12 15 = true := by
  decide +kernel

theorem n7305_slice4 : cosetSlice [25] 7 151 107 16 137 2 15 18 = true := by
  decide +kernel

/-- N7305: H = ZMod 25 (c = 7), x ↦ 16x, 9 classes, 97307 nodes; split at depth 2 into 5 slices. -/
theorem n7305_not_hasSDS : ¬ HasSDS (ZMod 175) 151 107 :=
  not_hasSDS_of_cosetRow' (ms := [175]) (ds := [25]) (c := 7) (t := 16) (s := 137)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [25]) (c := 7) (k := 151)
      (lam := 107) (t := 16) (s := 137) (d := 2)
      [7, 10, 12, 15, 18]
      (by decide +kernel) <|
      .cons n7305_slice0 <|
      .cons n7305_slice1 <|
      .cons n7305_slice2 <|
      .cons n7305_slice3 <|
      .cons n7305_slice4 <|
      .single) _

theorem n16679_slice0 : cosetSlice [85] 3 142 21 11 74 2 0 6 = true := by
  decide +kernel

theorem n16679_slice1 : cosetSlice [85] 3 142 21 11 74 2 6 9 = true := by
  decide +kernel

theorem n16679_slice2 : cosetSlice [85] 3 142 21 11 74 2 9 11 = true := by
  decide +kernel

theorem n16679_slice3 : cosetSlice [85] 3 142 21 11 74 2 11 15 = true := by
  decide +kernel

theorem n16679_slice4 : cosetSlice [85] 3 142 21 11 74 2 15 19 = true := by
  decide +kernel

/-- N16679: H = ZMod 85 (c = 3), x ↦ 11x, 10 classes, 112061 nodes; split at depth 2 into 5 slices.
-/
theorem n16679_not_hasSDS : ¬ HasSDS (ZMod 255) 142 21 :=
  not_hasSDS_of_cosetRow' (ms := [255]) (ds := [85]) (c := 3) (t := 11) (s := 74)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [85]) (c := 3) (k := 142)
      (lam := 21) (t := 11) (s := 74) (d := 2)
      [6, 9, 11, 15, 19]
      (by decide +kernel) <|
      .cons n16679_slice0 <|
      .cons n16679_slice1 <|
      .cons n16679_slice2 <|
      .cons n16679_slice3 <|
      .cons n16679_slice4 <|
      .single) _

theorem n58509_slice0 : cosetSlice [91] 5 214 93 11 206 2 0 11 = true := by
  decide +kernel

theorem n58509_slice1 : cosetSlice [91] 5 214 93 11 206 2 11 13 = true := by
  decide +kernel

theorem n58509_slice2 : cosetSlice [91] 5 214 93 11 206 2 13 17 = true := by
  decide +kernel

theorem n58509_slice3 : cosetSlice [91] 5 214 93 11 206 2 17 19 = true := by
  decide +kernel

theorem n58509_slice4 : cosetSlice [91] 5 214 93 11 206 2 19 28 = true := by
  decide +kernel

/-- N58509: H = ZMod 91 (c = 5), x ↦ 11x, 10 classes, 99612 nodes; split at depth 2 into 5 slices.
-/
theorem n58509_not_hasSDS : ¬ HasSDS (ZMod 455) 214 93 :=
  not_hasSDS_of_cosetRow' (ms := [455]) (ds := [91]) (c := 5) (t := 11) (s := 206)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [91]) (c := 5) (k := 214)
      (lam := 93) (t := 11) (s := 206) (d := 2)
      [11, 13, 17, 19, 28]
      (by decide +kernel) <|
      .cons n58509_slice0 <|
      .cons n58509_slice1 <|
      .cons n58509_slice2 <|
      .cons n58509_slice3 <|
      .cons n58509_slice4 <|
      .single) _

end SignedDifferenceSets.CosetRows
