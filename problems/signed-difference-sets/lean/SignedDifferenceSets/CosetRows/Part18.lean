module

public import SignedDifferenceSets.CosetSearch

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 18

2 open rows (N46320 to N12455 in search order), each closed by C16 for squarefree n
(`not_hasSDS_of_cosetRow`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n46320_slice0 : cosetSlice [81] 5 336 185 70 274 3 0 12 = true := by
  decide +kernel

theorem n46320_slice1 : cosetSlice [81] 5 336 185 70 274 3 12 19 = true := by
  decide +kernel

theorem n46320_slice2 : cosetSlice [81] 5 336 185 70 274 3 19 24 = true := by
  decide +kernel

theorem n46320_slice3 : cosetSlice [81] 5 336 185 70 274 3 24 28 = true := by
  decide +kernel

theorem n46320_slice4 : cosetSlice [81] 5 336 185 70 274 3 28 36 = true := by
  decide +kernel

/-- N46320: H = ZMod 81 (c = 5), x ↦ 70x, 9 classes, 120670 nodes; split at depth 3 into 5 slices.
-/
theorem n46320_not_hasSDS : ¬ HasSDS (ZMod 405) 336 185 :=
  not_hasSDS_of_cosetRow (ms := [405]) (ds := [81]) (c := 5) (t := 70) (s := 274)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [81]) (c := 5) (k := 336)
      (lam := 185) (t := 70) (s := 274) (d := 3)
      [12, 19, 24, 28, 36]
      (by decide +kernel) <|
      .cons n46320_slice0 <|
      .cons n46320_slice1 <|
      .cons n46320_slice2 <|
      .cons n46320_slice3 <|
      .cons n46320_slice4 <|
      .single) _

theorem n12455_slice0 : cosetSlice [1, 25] 9 32 1 6 16 2 0 5 = true := by
  decide +kernel

theorem n12455_slice1 : cosetSlice [1, 25] 9 32 1 6 16 2 5 6 = true := by
  decide +kernel

theorem n12455_slice2 : cosetSlice [1, 25] 9 32 1 6 16 2 6 8 = true := by
  decide +kernel

theorem n12455_slice3 : cosetSlice [1, 25] 9 32 1 6 16 2 8 9 = true := by
  decide +kernel

theorem n12455_slice4 : cosetSlice [1, 25] 9 32 1 6 16 2 9 10 = true := by
  decide +kernel

theorem n12455_slice5 : cosetSlice [1, 25] 9 32 1 6 16 2 10 14 = true := by
  decide +kernel

/-- N12455: H = ZMod 1 × ZMod 25 (c = 9), x ↦ 6x, 9 classes, 68904 nodes; split at depth 2 into 6
slices. -/
theorem n12455_not_hasSDS : ¬ HasSDS (ZMod 3 × ZMod 75) 32 1 :=
  not_hasSDS_of_cosetRow (ms := [3, 75]) (ds := [1, 25]) (c := 9) (t := 6) (s := 16)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 25]) (c := 9) (k := 32)
      (lam := 1) (t := 6) (s := 16) (d := 2)
      [5, 6, 8, 9, 10, 14]
      (by decide +kernel) <|
      .cons n12455_slice0 <|
      .cons n12455_slice1 <|
      .cons n12455_slice2 <|
      .cons n12455_slice3 <|
      .cons n12455_slice4 <|
      .cons n12455_slice5 <|
      .single) _

end SignedDifferenceSets.CosetRows
