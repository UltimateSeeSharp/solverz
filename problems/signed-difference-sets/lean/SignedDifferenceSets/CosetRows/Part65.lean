module

public import SignedDifferenceSets.CosetSearchWitt

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 65

1 open rows (N7696 to N7696 in search order), each closed by C10 for every n
(`not_hasSDS_of_cosetRow'`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n7696_slice0 : cosetSlice [45] 4 61 12 7 47 3 0 9 = true := by
  decide +kernel

theorem n7696_slice1 : cosetSlice [45] 4 61 12 7 47 3 9 15 = true := by
  decide +kernel

theorem n7696_slice2 : cosetSlice [45] 4 61 12 7 47 3 15 16 = true := by
  decide +kernel

theorem n7696_slice3 : cosetSlice [45] 4 61 12 7 47 3 16 17 = true := by
  decide +kernel

theorem n7696_slice4 : cosetSlice [45] 4 61 12 7 47 3 17 18 = true := by
  decide +kernel

theorem n7696_slice5 : cosetSlice [45] 4 61 12 7 47 3 18 22 = true := by
  decide +kernel

theorem n7696_slice6 : cosetSlice [45] 4 61 12 7 47 3 22 30 = true := by
  decide +kernel

theorem n7696_slice7 : cosetSlice [45] 4 61 12 7 47 3 30 36 = true := by
  decide +kernel

/-- N7696: H = ZMod 45 (c = 4), x ↦ 7x, 10 classes, 140644 nodes; split at depth 3 into 8 slices. -/
theorem n7696_not_hasSDS : ¬ HasSDS (ZMod 180) 61 12 :=
  not_hasSDS_of_cosetRow' (ms := [180]) (ds := [45]) (c := 4) (t := 7) (s := 47)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [45]) (c := 4) (k := 61)
      (lam := 12) (t := 7) (s := 47) (d := 3)
      [9, 15, 16, 17, 18, 22, 30, 36]
      (by decide +kernel) <|
      .cons n7696_slice0 <|
      .cons n7696_slice1 <|
      .cons n7696_slice2 <|
      .cons n7696_slice3 <|
      .cons n7696_slice4 <|
      .cons n7696_slice5 <|
      .cons n7696_slice6 <|
      .cons n7696_slice7 <|
      .single) _

end SignedDifferenceSets.CosetRows
