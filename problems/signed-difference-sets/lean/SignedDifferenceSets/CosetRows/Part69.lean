module

public import SignedDifferenceSets.CosetSearchWitt

/-!
# Rows killed by coset sums fixed by a multiplier (A7), part 69

1 open rows (N45790 to N45790 in search order), each closed by C10 for every n
(`not_hasSDS_of_cosetRow'`) and the coset search on a quotient of order prime to n (generated by
`solver/a7rows.py`).
-/

@[expose] public section

namespace SignedDifferenceSets.CosetRows

set_option maxRecDepth 100000

theorem n45790_slice0 : cosetSlice [27] 15 125 1 4 23 2 0 7 = true := by
  decide +kernel

theorem n45790_slice1 : cosetSlice [27] 15 125 1 4 23 2 7 9 = true := by
  decide +kernel

theorem n45790_slice2 : cosetSlice [27] 15 125 1 4 23 2 9 11 = true := by
  decide +kernel

theorem n45790_slice3 : cosetSlice [27] 15 125 1 4 23 2 11 13 = true := by
  decide +kernel

theorem n45790_slice4 : cosetSlice [27] 15 125 1 4 23 2 13 14 = true := by
  decide +kernel

theorem n45790_slice5 : cosetSlice [27] 15 125 1 4 23 2 14 18 = true := by
  decide +kernel

theorem n45790_slice6 : cosetSlice [27] 15 125 1 4 23 2 18 19 = true := by
  decide +kernel

theorem n45790_slice7 : cosetSlice [27] 15 125 1 4 23 2 19 23 = true := by
  decide +kernel

theorem n45790_slice8 : cosetSlice [27] 15 125 1 4 23 2 23 25 = true := by
  decide +kernel

/-- N45790: H = ZMod 27 (c = 15), x ↦ 4x, 7 classes, 137974 nodes; split at depth 2 into 9 slices.
-/
theorem n45790_not_hasSDS : ¬ HasSDS (ZMod 405) 125 1 :=
  not_hasSDS_of_cosetRow' (ms := [405]) (ds := [27]) (c := 15) (t := 4) (s := 23)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [27]) (c := 15) (k := 125)
      (lam := 1) (t := 4) (s := 23) (d := 2)
      [7, 9, 11, 13, 14, 18, 19, 23, 25]
      (by decide +kernel) <|
      .cons n45790_slice0 <|
      .cons n45790_slice1 <|
      .cons n45790_slice2 <|
      .cons n45790_slice3 <|
      .cons n45790_slice4 <|
      .cons n45790_slice5 <|
      .cons n45790_slice6 <|
      .cons n45790_slice7 <|
      .cons n45790_slice8 <|
      .single) _

end SignedDifferenceSets.CosetRows
