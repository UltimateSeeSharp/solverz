  decide +kernel

theorem n31518_slice5 : cosetSlice [31] 11 281 118 8 201 1 8 10 = true := by
  decide +kernel

/-- N31518: H = ZMod 31 (c = 11), x ↦ 8x, 7 classes, 76261 nodes; split at depth 1 into 6 slices. -/
theorem n31518_not_hasSDS : ¬ HasSDS (ZMod 341) 281 118 :=
  not_hasSDS_of_cosetRow (ms := [341]) (ds := [31]) (c := 11) (t := 8) (s := 201)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [31]) (c := 11) (k := 281)
      (lam := 118) (t := 8) (s := 201) (d := 1)
      [3, 4, 5, 6, 8, 10]
      (by decide +kernel) <|
      .cons n31518_slice0 <|
      .cons n31518_slice1 <|
      .cons n31518_slice2 <|
      .cons n31518_slice3 <|
      .cons n31518_slice4 <|
      .cons n31518_slice5 <|
      .single) _

