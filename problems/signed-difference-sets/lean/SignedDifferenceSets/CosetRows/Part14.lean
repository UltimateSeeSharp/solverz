  not_hasSDS_of_cosetRow (ms := [3, 93]) (ds := [1, 31]) (c := 9) (t := 8) (s := 109)
    (by decide +kernel) (by decide +kernel)
    (cosetSearch_of_slices (ds := [1, 31]) (c := 9) (k := 205)
      (lam := 42) (t := 8) (s := 109) (d := 1)
      [3, 4, 5, 6, 8, 10]
      (by decide +kernel) <|
      .cons n20702_slice0 <|
      .cons n20702_slice1 <|
      .cons n20702_slice2 <|
      .cons n20702_slice3 <|
      .cons n20702_slice4 <|
      .cons n20702_slice5 <|
      .single) _

