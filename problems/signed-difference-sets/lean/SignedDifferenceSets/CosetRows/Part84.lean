/-- N8585: H = ZMod 27 (c = 7), x ↦ 4x, 7 classes, 262958 nodes; split at depth 2 into 14 slices. -/
theorem n8585_not_hasSDS : ¬ HasSDS (ZMod 189) 173 1 :=
