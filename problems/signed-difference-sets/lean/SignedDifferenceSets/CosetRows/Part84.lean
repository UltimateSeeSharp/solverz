      (lam := 1) (t := 4) (s := 19) (d := 2)
      [5, 7, 10, 11, 12, 16, 17, 18, 19, 22, 23, 24, 27, 32]
      (by decide +kernel) <|
      .cons n8585_slice0 <|
      .cons n8585_slice1 <|
      .cons n8585_slice2 <|
      .cons n8585_slice3 <|
      .cons n8585_slice4 <|
      .cons n8585_slice5 <|
      .cons n8585_slice6 <|
