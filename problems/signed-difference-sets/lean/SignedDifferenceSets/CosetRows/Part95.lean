theorem n22696_slice0 : cosetSlice [145] 2 202 6 7 44 1 0 3 = true := by
  decide +kernel

theorem n22696_slice1 : cosetSlice [145] 2 202 6 7 44 1 3 5 = true := by
  decide +kernel

/-- N22696: H = ZMod 145 (c = 2), x ↦ 7x, self-conjugate [2], 10 classes, 41342 nodes; split at
depth 1 into 2 slices. -/
theorem n22696_not_hasSDS : ¬ HasSDS (ZMod 290) 202 6 :=
  not_hasSDS_of_cosetRowSelfConj (ms := [290]) (ds := [145]) (c := 2) (t := 7) (s := 44)
    (by decide +kernel)
    (cosetSearch_of_slices (ds := [145]) (c := 2) (k := 202)
      (lam := 6) (t := 7) (s := 44) (d := 1)
      [3, 5]
      (by decide +kernel) <|
      .cons n22696_slice0 <|
      .cons n22696_slice1 <|
      .single) _

