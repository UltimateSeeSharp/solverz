module

public import SignedDifferenceSets.ContractionCheck

/-!
# N221: no (40, 22, 6) SDS in C₂ × C₂₀

Open in Gordon's table (`SDS(40,22,6,[2,20])`, 2026-11-05).
Contract along C₂ × C₂₀ → C₂ × C₄ (F3): fibres of 5 elements, so the coset
sums lie in [−5, 5], have square sum 22 + 6 · 4 = 46, sum ±16 and
autocorrelation 6 · 5 = 30 at every shift ≠ 0; `noVector` (`decide +kernel`)
finds no such vector. Quotient from E5; this file is generated by `solver/answer.py`.
-/

@[expose] public section

namespace SignedDifferenceSets.Answer.N221

/-- The projection C₂ × C₂₀ → C₂ × C₄, factor by factor. -/
def proj : Proj (ZMod 2 × ZMod 20) (ZMod 2 × ZMod 4) :=
  .prod (.cast 2 (by norm_num))
    (.cast 4 (by norm_num))

set_option maxRecDepth 100000 in
-- `decide +kernel` runs the vector search.
/-- N221: C₂ × C₂₀ has no signed difference set with parameters (40, 22, 6). -/
theorem not_hasSDS : ¬ HasSDS (ZMod 2 × ZMod 20) 22 6 :=
  not_hasSDS_of_noVector proj 5 16 (by simp [Fintype.card_prod, ZMod.card])
    (by norm_num [Fintype.card_prod, ZMod.card]) (by decide +kernel)

end SignedDifferenceSets.Answer.N221
