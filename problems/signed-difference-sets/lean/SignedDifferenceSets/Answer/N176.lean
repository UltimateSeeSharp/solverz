namespace SignedDifferenceSets.Answer.N176

/-- The projection C₂ × C₁₈ → C₉, factor by factor. -/
def proj : Proj (ZMod 2 × ZMod 18) (ZMod 1 × ZMod 9) :=
  .prod (.cast 1 (by norm_num))
