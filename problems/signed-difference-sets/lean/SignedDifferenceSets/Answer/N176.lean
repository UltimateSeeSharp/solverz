set_option maxRecDepth 100000 in
-- `decide +kernel` runs the vector search.
/-- N176: C₂ × C₁₈ has no signed difference set with parameters (36, 29, 20). -/
theorem not_hasSDS : ¬ HasSDS (ZMod 2 × ZMod 18) 29 20 :=
