module

public import SignedDifferenceSets.ContractionCheck

/-!
# N95: no (28, 19, 10) SDS in C₂ × C₁₄

Open in Gordon's table (`SDS(28,19,10,[2,14])`, 2026-11-05).
Contract along C₂ × C₁₄ → C₇ (C3): fibres of 4 elements, so the coset
sums lie in [−4, 4], have square sum 19 + 10 · 3 = 49, sum ±17 and
autocorrelation 10 · 4 = 40 at every shift ≠ 0; `noVector` (`decide +kernel`)
finds no such vector. Quotient from E5; this file is generated by `solver/answer.py`.
-/

@[expose] public section

namespace SignedDifferenceSets.Answer.N95

/-- The projection C₂ × C₁₄ → C₇, factor by factor. -/
def proj : Proj (ZMod 2 × ZMod 14) (ZMod 1 × ZMod 7) :=
  .prod (.cast 1 (by norm_num))
    (.cast 7 (by norm_num))

set_option maxRecDepth 100000 in
-- `decide +kernel` runs the vector search.
/-- N95: C₂ × C₁₄ has no signed difference set with parameters (28, 19, 10). -/
theorem not_hasSDS : ¬ HasSDS (ZMod 2 × ZMod 14) 19 10 :=
  not_hasSDS_of_noVector proj 4 17 (by simp [Fintype.card_prod, ZMod.card])
    (by norm_num [Fintype.card_prod, ZMod.card]) (by decide +kernel)

end SignedDifferenceSets.Answer.N95
