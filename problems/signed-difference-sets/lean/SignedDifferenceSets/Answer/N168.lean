module

public import SignedDifferenceSets.ContractionCheck

/-!
# N168: no (36, 11, 2) SDS in C₂ × C₁₈

Open in Gordon's table (`SDS(36,11,2,[2,18])`, 2026-11-05).
Contract along C₂ × C₁₈ → C₉ (F3): fibres of 4 elements, so the coset
sums lie in [−4, 4], have square sum 11 + 2 · 3 = 17, sum ±9 and
autocorrelation 2 · 4 = 8 at every shift ≠ 0; `noVector` (`decide +kernel`)
finds no such vector. Quotient from E5; this file is generated by `solver/answer.py`.
-/

@[expose] public section

namespace SignedDifferenceSets.Answer.N168

/-- The projection C₂ × C₁₈ → C₉, factor by factor. -/
def proj : Proj (ZMod 2 × ZMod 18) (ZMod 1 × ZMod 9) :=
  .prod (.cast 1 (by norm_num))
    (.cast 9 (by norm_num))

set_option maxRecDepth 100000 in
-- `decide +kernel` runs the vector search.
/-- N168: C₂ × C₁₈ has no signed difference set with parameters (36, 11, 2). -/
theorem not_hasSDS : ¬ HasSDS (ZMod 2 × ZMod 18) 11 2 :=
  not_hasSDS_of_noVector proj 4 9 (by simp [Fintype.card_prod, ZMod.card])
    (by norm_num [Fintype.card_prod, ZMod.card]) (by decide +kernel)

end SignedDifferenceSets.Answer.N168
