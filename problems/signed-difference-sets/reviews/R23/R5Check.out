@not_hasSDS_of_mem_part01 : ∀ {x : Row × MaRowCert},
  x ∈ part01 → ∀ (inst : Fintype (Grp x.1.ms)), ¬HasSDS (Grp x.1.ms) x.1.k x.1.lam
def SignedDifferenceSets.MaRule : Prop :=
∀ (G K : Type) [inst : AddCommGroup G] [inst_1 : Fintype G] [inst_2 : AddCommGroup K] [inst_3 : Fintype K]
  [DecidableEq K] (p r i e b c k : ℕ) (lam : ℤ) [Fact (Nat.Prime p)] [inst_6 : NeZero (r * p)]
  (φ : G →+ ZMod (r * p) × K),
  Function.Surjective ⇑φ →
    Fintype.card G = c * Fintype.card (ZMod (r * p) × K) →
      0 < r →
        0 < i →
          (∀ (x : K), p ^ i • x = -x) →
            ↑p ^ e ∣ ↑k - lam →
              ↑k ≠ lam →
                2 * b ≤ e →
                  2 * c < p ^ b →
                    (∀ (S : Type) [inst : CommRing S] (x : S),
                        ∑ l ∈ Finset.range p, (x ^ r) ^ l = 0 →
                          ∃ y z, ↑p = (x - 1) ^ ((p - 1) * r) * y ∧ (x - 1) ^ ((p - 1) * r) = ↑p * z) →
                      ¬HasSDS G k lam

real	0m35.589s
