/-- The pairs `(p, r)` the rows use. -/
def maPairs : List (ℕ × ℕ) :=
  [(2, 1), (2, 2), (2, 4), (2, 8), (2, 16), (2, 32), (2, 64), (2, 128), (3, 1), (3, 3), (3, 9),
