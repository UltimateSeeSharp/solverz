theorem part05_kills : ∀ x ∈ part05, x.2.Kills x.1 ∧ (x.2.p, x.2.r) ∈ maPairs := by
  decide +kernel

/-- No row of part 05 has an SDS, given C21. -/
theorem part05_not_hasSDS (hrule : MaRule) {x : Row × MaRowCert} (hx : x ∈ part05)
    (inst : Fintype (Grp x.1.ms)) : ¬ @HasSDS (Grp x.1.ms) _ inst x.1.k x.1.lam :=
  MaRowCert.not_hasSDS hrule (part05_kills x hx).1
    (cycloFacts_of_mem_maPairs (part05_kills x hx).2) inst

