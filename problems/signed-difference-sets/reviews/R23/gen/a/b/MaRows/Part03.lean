/-- No row of part 03 has an SDS, given C21. -/
theorem part03_not_hasSDS (hrule : MaRule) {x : Row × MaRowCert} (hx : x ∈ part03)
    (inst : Fintype (Grp x.1.ms)) : ¬ @HasSDS (Grp x.1.ms) _ inst x.1.k x.1.lam :=
  MaRowCert.not_hasSDS hrule (part03_kills x hx).1
    (cycloFacts_of_mem_maPairs (part03_kills x hx).2) inst

