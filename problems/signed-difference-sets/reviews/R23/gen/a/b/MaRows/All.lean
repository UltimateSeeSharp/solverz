module

public import SignedDifferenceSets.MaLemma
public import SignedDifferenceSets.MaRows.Part01
public import SignedDifferenceSets.MaRows.Part02
public import SignedDifferenceSets.MaRows.Part03
public import SignedDifferenceSets.MaRows.Part04
public import SignedDifferenceSets.MaRows.Part05
public import SignedDifferenceSets.MaRows.Part06

/-!
# Rows killed by C21

C21's rule is `maRule` (`MaLemma.lean`), so each part's theorem holds without its hypothesis.
`maRows` lists all 1457 rows; generated by `solver/marows.py`.
-/

@[expose] public section

namespace SignedDifferenceSets.MaRows

/-- No row of part 01 has an SDS. -/
theorem not_hasSDS_of_mem_part01 {x : Row × MaRowCert} (hx : x ∈ part01)
    (inst : Fintype (Grp x.1.ms)) : ¬ @HasSDS (Grp x.1.ms) _ inst x.1.k x.1.lam :=
  part01_not_hasSDS maRule hx inst

/-- No row of part 02 has an SDS. -/
theorem not_hasSDS_of_mem_part02 {x : Row × MaRowCert} (hx : x ∈ part02)
    (inst : Fintype (Grp x.1.ms)) : ¬ @HasSDS (Grp x.1.ms) _ inst x.1.k x.1.lam :=
  part02_not_hasSDS maRule hx inst

/-- No row of part 03 has an SDS. -/
theorem not_hasSDS_of_mem_part03 {x : Row × MaRowCert} (hx : x ∈ part03)
    (inst : Fintype (Grp x.1.ms)) : ¬ @HasSDS (Grp x.1.ms) _ inst x.1.k x.1.lam :=
  part03_not_hasSDS maRule hx inst

/-- No row of part 04 has an SDS. -/
theorem not_hasSDS_of_mem_part04 {x : Row × MaRowCert} (hx : x ∈ part04)
    (inst : Fintype (Grp x.1.ms)) : ¬ @HasSDS (Grp x.1.ms) _ inst x.1.k x.1.lam :=
  part04_not_hasSDS maRule hx inst

/-- No row of part 05 has an SDS. -/
theorem not_hasSDS_of_mem_part05 {x : Row × MaRowCert} (hx : x ∈ part05)
    (inst : Fintype (Grp x.1.ms)) : ¬ @HasSDS (Grp x.1.ms) _ inst x.1.k x.1.lam :=
  part05_not_hasSDS maRule hx inst

/-- No row of part 06 has an SDS. -/
theorem not_hasSDS_of_mem_part06 {x : Row × MaRowCert} (hx : x ∈ part06)
    (inst : Fintype (Grp x.1.ms)) : ¬ @HasSDS (Grp x.1.ms) _ inst x.1.k x.1.lam :=
  part06_not_hasSDS maRule hx inst

/-- Every row C21 kills, with its certificate. -/
def maRows : List (Row × MaRowCert) :=
  part01 ++ part02 ++ part03 ++ part04 ++ part05 ++ part06

/-- No row of `maRows` has an SDS. -/
theorem not_hasSDS_of_mem_maRows {x : Row × MaRowCert} (hx : x ∈ maRows)
    (inst : Fintype (Grp x.1.ms)) : ¬ @HasSDS (Grp x.1.ms) _ inst x.1.k x.1.lam := by
  simp only [maRows, List.mem_append, or_assoc] at hx
  rcases hx with h | h | h | h | h | h
  exacts [not_hasSDS_of_mem_part01 h inst, not_hasSDS_of_mem_part02 h inst,
    not_hasSDS_of_mem_part03 h inst, not_hasSDS_of_mem_part04 h inst,
    not_hasSDS_of_mem_part05 h inst, not_hasSDS_of_mem_part06 h inst]

end SignedDifferenceSets.MaRows
