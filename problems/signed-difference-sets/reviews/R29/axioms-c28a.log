  [inst_6 : SignedDifferenceSets.Indexed (ZMod r × K)] {φ : G →+ ZMod (r * 2) × K},
  Function.Surjective ⇑φ →
    Fintype.card G = c * Fintype.card (ZMod (r * 2) × K) →
      0 < r →
        0 < i →
          (∀ (x : K), 2 ^ i • x = -x) →
            2 ^ 2 ∣ ↑k - lam →
              SignedDifferenceSets.CycloFacts 2 r →
                ∀ {s s₂ Q t K' : ℤ},
                  s * s = ↑k + lam * (↑(Fintype.card G) - 1) →
