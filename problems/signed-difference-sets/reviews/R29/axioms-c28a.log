def SignedDifferenceSets.EvenCert.Ok : SignedDifferenceSets.Row → SignedDifferenceSets.EvenCert → Prop :=
fun w e =>
  0 < e.r ∧
    0 < e.i ∧
      (∀ m ∈ w.ms, 0 < m) ∧
        e.ks ≠ [] ∧
          (∀ d ∈ e.ks, d ∣ 2 ^ e.i + 1) ∧
            SignedDifferenceSets.MapOk w.ms (e.r * 2 :: e.ks) e.A ∧
