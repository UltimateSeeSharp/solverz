                          w.lam * ↑(SignedDifferenceSets.EvenCert.c w e) % 2 = 0 ∧
                            (e.K - e.s / 2) % 2 = 0 ∧
                              ↑w.k < 2 * e.K + 4 ∧ (2, e.r) ∈ SignedDifferenceSets.MaRows.maPairs

