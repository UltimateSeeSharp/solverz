@not_hasSDS_of_compositeModulus : ∀ {G : Type u_1} {H : Type u_2} [inst : AddCommGroup G] [inst_1 : Fintype G]
  [inst_2 : AddCommGroup H] [inst_3 : Fintype H] (φ : G →+ H),
  Function.Surjective ⇑φ →
    ∀ {c : ℕ},
      Fintype.card G = c * Fintype.card H →
        (∃ g, g ≠ 0) →
          ∀ {k : ℕ} {lam : ℤ},
            ↑k ≠ lam →
              ∀ {L : List (ℕ × ℕ × ℕ)},
                (∀ x ∈ L, SelfConjOn H k lam x) →
                  List.Pairwise (fun x y => x.1 ≠ y.1) L →
                    ∀ {s : ℤ},
                      s ^ 2 = ↑k + lam * (↑c * ↑(Fintype.card H) - 1) →
                        (∀ s' ∈ [s, -s],
                            ∀ t0 ∈ Finset.Ico 0 (modulusProd L),
                              ¬BoxOk (↑(Fintype.card H)) (modulusProd L) s' (↑k + lam * (↑c - 1)) t0 ↑c) →
                          ¬HasSDS G k lam
@CmCert.not_hasSDS : ∀ {r : Row} {c : CmCert},
  CmCert.Kills r c → ∀ (inst : Fintype (Grp r.ms)), ¬HasSDS (Grp r.ms) r.k r.lam

