@not_hasSDS_of_sylow : ∀ {G : Type u_1} [inst : AddCommGroup G] [inst_1 : Fintype G] (ds : List ℕ)
  [inst_2 : Fintype (Grp ds)] {p r : ℕ} [hp : Fact (Nat.Prime p)] [NeZero (r * p)],
  SylowTrace.PPowers p (r * p) ds →
    ∀ (φ : G →+ Grp ds),
      Function.Surjective ⇑φ →
        ∀ {c : ℕ},
          Fintype.card G = c * Fintype.card (Grp ds) →
            ∀ {k : ℕ} {lam : ℤ} {e q t : ℕ},
              ↑p ^ e ∣ ↑k - lam →
                2 * (q * ((p - 1) * r) + 1) ≤ e * ((p - 1) * r) →
                  Fintype.card (Grp ds) = p ^ t →
                    ∀ {s : ℤ},
                      s ^ 2 = ↑k + lam * (↑c * ↑(Fintype.card (Grp ds)) - 1) →
                        ¬↑p ^ min t (q + 1) ∣ s →
                          (∀ (S : Type) [inst : CommRing S] (x : S),
                              ∑ l ∈ Finset.range p, (x ^ r) ^ l = 0 →
                                ∃ y z, ↑p = (x - 1) ^ ((p - 1) * r) * y ∧ (x - 1) ^ ((p - 1) * r) = ↑p * z) →
                            ¬HasSDS G k lam

